
@{
    ViewBag.Title = "UserWiseMenuAllotment";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/AccessControl/JsModule/Config/UserWiseMenuAllotment.js"></script>
<style>
    .card-body {
        padding: 5px 15px;
        color: var(--default-text-color);
    }

    .mb-3 {
        margin-bottom: 5px !important;
    }

    .col-sm-6 {
        flex: 0 0 auto;
        width: 49%;
    }

    .btn-group {
        position: fixed;
        top: 55%;
        display: inline-flex;
    }

    .hide {
        display: none;
    }

    .form-group {
        padding: 0 6px;
        margin-bottom: 1rem;
    }

    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }

    .mileStones {
        margin-top: 5px;
        border-radius: 3px;
        background: #e4f4ff;
        display: flex;
        padding: 6px;
        align-items: anchor-center;
        border: 1px solid #ededed;
    }

    .accordion-item {
        margin: 5px 0;
        border-top: 1px solid var(--default-border) !important;
    }

        .accordion-item i {
            cursor: pointer;
        }

    .mileStones label.name {
        color: #1c63eb;
        font-weight: bold;
        cursor: pointer;
    }

    .blockUI {
        pointer-events: none;
        opacity: 0.5;
        display: flex;
    }

    .accordion-body {
        background: #f5f5f5;
        margin: 0px 6px 5px;
        border-radius: 3px;
        padding: 5px;
        font-size: .8125rem;
    }

        .accordion-body ul {
            background: #fff;
            padding: 5px 10px;
            border-radius: 3px;
            margin: 4px 10px;
            list-style: none;
        }

        .accordion-body label.menu {
            display: flex;
            font-weight: bold;
            color: #7d7676;
        }

    .hidden {
        display: none;
    }

    .mileStones label {
        width: 50%;
        font-size: 12px;
    }

    .mileStones select {
        width: 45%;
        font-size: 12px;
        height: 30px;
        margin-right: 5px;
    }

    .mileStones button {
        width: 6%;
        font-size: 12px;
    }

    .accordion-header {
        color: #fff;
        background: #05a5f4;
        padding: 6px 10px;
        font-size: 12px;
    }

        .accordion-header label {
            width: 56%;
        }

        .accordion-header select {
            line-height: 15px !important;
            height: 28px;
            width: 35% !important;
            border: 1px solid #ddd;
            border-radius: 3px;
        }

    .accordion-button {
        float: right;
        width: 8%;
        padding: 0px;
    }

    .accordion-header label {
        display: inline-flex;
    }

    .accordion-header input[type=checkbox] {
        width: 12px;
    }

    #MenuList, #AllotedMenuList {
        height: 66vh;
        overflow: auto;
    }

    .accordion-header .btnRemove {
        background: red;
        line-height: 0;
        padding: 0px;
        margin-top: -43px;
        right: 21px;
        position: absolute;
        color: #fff;
        width: 12px;
        z-index: 1111;
        height: 12px;
        border-radius: 38px;
        font-size: 10px;
    }

    .table thead td, .table thead th {
        /* padding: 2px 1px !important; */
        background: #05a5f4;
    }

    .input-group-text {
        border-color: var(--input-border);
        font-size: .875rem;
        border-radius: .3125rem;
        background: #bae0ff;
        /*background-color: rgb(var(--light-rgb));*/
        color: var(--default-text-color);
        letter-spacing: 0;
    }

    .tofixed {
        position: sticky;
        top: 0px;
    }

    .rowheader {
        border-radius: 2px;
        padding: 1px;
        background: #d8eeff;
        margin: 0px;
    }

    .select-row {
        background-color: #d3f5cd;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Menu And Unit Allotment
                        </div>
                    </div>
                    <hr style="margin:0px;border-color: #d0d0d0;" />
                    <div class="card-body">
                        <div class="row mb-3" style="background: #ebebeb;padding: 5px; margin:0px;">
                            <div class="col-sm-3">
                                <div class="input-group mb-3">
                                    <label class="input-group-text" for="inputGroupSelect01">Search</label>
                                    <input type="text" id="txtSearchEmp" class="form-control" onkeyup="SearchEmployee()" placeholder="Search.." />
                                </div>
                            </div>
                            <div class="col-sm-5">
                                <div class="input-group mb-3">
                                    <label class="input-group-text" for="inputGroupSelect01">Employee</label>
                                    <select class="form-control" id="ddlEmployee"></select>
                                </div>
                            </div>
                        </div>
                        <hr style="margin:0px;border-color: #d0d0d0;" />
                        <div class="row g-3">
                            <div class="col-sm-6 form-group" style="padding:0 10px;border: 1px solid #0d6efd;margin-right: 20px;">
                                <div class="row">
                                    <div class="col-sm-5 form-group">
                                        <div class="table-responsive" style="height:70vh;overflow-y:auto;padding:2px;">
                                            <table class="table text-nowrap" id="tblUnit">
                                                <thead class="tofixed">
                                                    <tr>
                                                        <th scope="col"><input type="checkbox" checked onchange="$('#tblUnit tbody input:checkbox').prop('checked',$(this).is(':checked'))" /></th>
                                                        <th scope="col"><input type="text" id="searchUnit" onkeyup="searchTable('searchUnit','tblUnit')" class="form-control" style="width: 93%;height: 22px;font-size: 12px;" placeholder="Unit Name.." /></th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="col-sm-2 form-group">
                                        <div class="btn-group">
                                            <button onclick="AllotMenu('AssignUnit')" class="btn btn-outline-primary btn-sm"><i class="fa fa-sign-in">&nbsp;</i></button>
                                            <button onclick="AllotMenu('DeleteUnit')" class="btn btn-outline-primary btn-sm"><i class="fa fa-trash-alt">&nbsp;</i></button>
                                        </div>
                                    </div>
                                    <div class="col-sm-5 form-group">
                                        <div class="table-responsive" style="height:70vh;overflow-y:auto;padding:2px;">
                                            <table class="table text-nowrap" id="tblAssignUnit">
                                                <thead class="tofixed">
                                                    <tr>
                                                        <th scope="col"><input type="checkbox" checked onchange="$('#tblAssignUnit tbody input:checkbox').prop('checked',$(this).is(':checked'))" /></th>
                                                        <th scope="col"><input type="text" id="searchUnit1" onkeyup="searchTable('searchUnit1','tblAssignUnit')" class="form-control" style="width: 93%;height: 22px;font-size: 12px;" placeholder="Unit Name.." /></th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 form-group" style="border: 1px solid #0d6efd;">
                                <div class="row g-3">

                                    <div class="col-sm-5 form-group">
                                        <div id="MenuList">

                                        </div>
                                    </div>
                                    <div class="col-sm-2 form-group">
                                        <div class="btn-group">
                                            <button onclick="AllotMenu('AssignMenu')" class="btn btn-outline-primary btn-sm"><i class="fa fa-sign-in">&nbsp;</i></button>
                                            <button onclick="AllotMenu('DeleteMenu')" class="btn btn-outline-primary btn-sm"><i class="fa fa-trash-alt">&nbsp;</i></button>
                                        </div>
                                    </div>
                                    <div class="col-sm-5 form-group">
                                        <div id="AllotedMenuList">

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>