
@{
    ViewBag.Title = "PackMaster";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/GeneralStore/JsModule/PackMaster.js"></script>

<style>

    .table td, .table th {
        padding: 5px;
        vertical-align: middle;
        line-height: 14px;
        font-size: 13px;
    }

    .table thead td, .table thead th {
        font-weight: 600;
        font-size: 12px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom-width: 1px;
        border-top-width: 0;
    }
    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .select-row {
        background-color: #edffd8;
    }

    limit.count {
        display: none;
        color: #fff;
        z-index: 10 !important;
        position: absolute !important;
        left: 2% !important;
        top: 80px;
        background: #ff583e !important;
        font-size: 9px;
        padding: 1px;
    }

    .bn {
        border-radius: 0px;
        height: 35px;
        padding: 2px;
        width: 100px;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }
    .borderbotton {
        border-bottom: 1px solid red !important;
    }
 
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-6">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Create Pack Type
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <label> Pack Qty</label>
                                <input type="text" id="txtPackQty"  data-int data-count="4" class="form-control mb-3 borderbotton" placeholder="Pack Qty" />
                            </div>
                            <div class="col-md-3">
                                <label>NOS </label>
                                <select id="ddlNOS" class="form-control mb-3 borderbotton">
                                    <option>Select NOS</option>
                                    <option>Kg</option>
                                    <option>Ltr</option>
                                    <option>ml</option>
                                    <option>Nos</option>
                                    <option>Amp</option>
                                    <option>Pkt</option>
                                    <option>Gm</option>
                                    <option>Test</option>
                                    <option>Pad</option>
                                    <option>Cap</option>
                                    <option>Tab</option>
                                    <option>Mg</option>
                                    <option>Vail</option>
                                    <option>Tube</option>
                                    <option>Mtr</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label> Pack Type</label>
                                <span data-packid style="display:none"></span>
                                <div style="display:flex">
                                    <input type="text" id="txtPackType" disabled="disabled" class="form-control mb-3 borderbotton" placeholder="Pack Type" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label> P. Qty</label>
                                <div style="display:flex">
                                    <input type="text" id="txtPQty"  data-int data-count="5" class="form-control mb-3 borderbotton" placeholder="P. Qty" />
                                    <input type="button" id="btnSavePackType" class="btn btn-success bn mb-3" value="Submit" />
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-xs-12">
                                <div style="display:flex">
                                    <input type="text" id="txtSearch" class="form-control input_pass mb-3" value="" placeholder="Search...">
                                    <button type="button" class="btn btn-warning bn mb-3" style="margin-left:10px" onclick="GetPackTypeList()">Load</button>
                                </div>
                            </div>

                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:60vh;overflow:auto;border:1px solid #2d82ff">
                                    <table class="table table-bordered" id="tblPack">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>Pack Type</th>
                                                <th style="text-align:center;width:20%">Pack Qty</th>
                                                <th style="width:1%">Cmd</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
