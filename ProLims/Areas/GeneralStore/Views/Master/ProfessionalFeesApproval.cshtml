
@{
    ViewBag.Title = "ProfessionalFeesApproval";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/GeneralStore/JsModule/ProfessionalFeesApproval.js"></script>
<style>
    .table td, .table th {
        padding: 5px;
        vertical-align: middle;
        line-height: 14px;
        font-size: 13px;
    }

    .table thead td, .table thead th {
        font-weight: 600;
        font-size: 12px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom-width: 1px;
        border-top-width: 0;
    }



    .form-group {
        margin-bottom: 5px;
    }

    hr {
        margin: 5px;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }


    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .select-row {
        background-color: #a1f1a4;
    }

    .card-body {
        padding: 10px 10px;
        color: var(--default-text-color);
    }

    .text-red {
        color: #dd4b39 !important;
    }

    .text-blue {
        color: #0073b7 !important;
    }

    .border-imp {
        border-bottom: 2px solid red !important;
    }

    .text-green {
        color: #054608 !important;
    }

    .search-section {
        border: 1px solid #ddd;
        padding: 5px;
        background: #d6ebfb;
        padding: 5px;
        text-align: center;
        margin: 0px;
        margin-bottom: 5px;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-10">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Professional Fees Doctor Pending List
                        </div>

                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <div style="display:flex">
                                    <select id="ddlReportType" class="form-control">
                                        <option value="ALL">ALL</option>
                                        <option value="Pending" selected>Pending</option>
                                        <option value="Approve">Approve</option>
                                    </select>
                                    <button id="btnSearch" class="btn btn-primary" type="button" style="width:30%" onclick="Onload(this)"><sapn class="fa fa-search"></sapn>&nbsp;Search</button>
                                    <button id="btnApprove" class="btn btn-success" type="button" style="width:30%;margin-left:10px" onclick="Approvedata(this)"><sapn class="fa fa-check"></sapn>&nbsp;Approve</button>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <input type="text" id="txtSearch" class="form-control" autocomplete="off" placeholder="Search Doctor Name" style="border:1px solid #86b3de;margin-top: 5px;">
                                <div class="table-responsive" style="height:65vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblReport">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th style="width:5%;text-align:center"> <input type="checkbox" id="chkallshift" /></th>
                                                @*<th>Item ID</th>*@
                                                <th>Item Name </th>
                                                <th style="text-align:center">Amount</th>
                                                <th>Approve By</th>
                                                <th>Approve Date</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

