
@{
    ViewBag.Title = "CategoryMaster";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/GeneralStore/JsModule/CategoryMaster.js"></script>
<style>

    .table td, .table th {
        padding: 5px;
        vertical-align: middle;
        line-height: 14px;
        font-size: 13px;
    }

    .table thead td, .table thead th {
        font-weight: 600;
        font-size: 12px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom-width: 1px;
        border-top-width: 0;
    }

    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .select-row {
        background-color: #bff5c2;
    }

    limit.count {
        display: none;
        color: #fff;
        z-index: 10 !important;
        position: absolute !important;
        left: 2% !important;
        top: 80px;
        background: #ff583e !important;
        font-size: 9px;
        padding: 1px;
    }

    .bn {
        border-radius: 0px;
        height: 35px;
        padding: 2px;
        width: 100px;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .borderbotton {
        border-bottom: 1px solid red !important;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-6">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Create Category Master
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <label> Main Category</label>
                                <select id="ddlMainCategory" class="form-control"></select>
                            </div>

                            <div class="col-md-8">
                                <label>Category</label>
                                <div style="display:flex">
                                    <input type="text" id="txtCatName" class="form-control mb-3 borderbotton" placeholder="Enter Category Name" />
                                    <input type="button" id="btnSaveCategory" class="btn btn-success bn" value="Submit" />
                                    @*<button id="btnSaveCategory" class="btn btn-success mb-3" style="float: right;width: 100px; margin-left: 10px;"> <i class="fa fa-save"></i>&nbsp; Save</button>*@
                                </div>
                               
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div style="display:flex">
                                    <input type="text" id="txtSearch" class="form-control input_pass mb-3" value="" placeholder="Search...">
                                    <button type="button" class="btn btn-primary bn mb-3" style="margin-left:10px" onclick="GetCategoryList()">Load</button>

                                </div>

                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:63vh;overflow:auto;border:1px solid #2d82ff">
                                    <table class="table table-bordered" id="tblCategory">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th style="width:1%">Edit</th>
                                                <th>Category Name</th>
                                                <th style="width:1%">Delete</th>

                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
