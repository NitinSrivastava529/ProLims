
@{
    ViewBag.Title = "BestRateMaster";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/GeneralStore/JsModule/BestRateMaster.js"></script>
<script src="~/JsModule/FileSaver.min.js"></script>
<style>
    .toggle {
        margin-bottom: 0 !IMPORTANT;
        margin: 0;
    }

        .toggle.on {
            background-color: rgba(var(--success-rgb), .4);
        }

            .toggle.on span {
                background-color: rgba(var(--success-rgb), .4);
            }

        .toggle.off {
            background-color: #f9afaa;
        }

            .toggle.off span {
                background-color: #f9afaa;
            }

    .table td, .table th {
        padding: 5px;
        vertical-align: middle;
        line-height: 14px;
        font-size: 13px;
    }

    .table thead td, .table thead th {
        font-weight: 600;
        font-size: 12px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom-width: 1px;
        border-top-width: 0;
        padding: 5px;
    }

    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .select-row {
        background-color: #edffd8;
    }

    limit.count {
        display: none;
        color: #fff;
        z-index: 10 !important;
        position: absolute !important;
        left: 2% !important;
        top: 80px;
        background: #ff583e !important;
        font-size: 9px;
        padding: 1px;
    }

    .bn {
        border-radius: 0px;
        height: 35px;
        padding: 2px;
        width: 100px;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .borderbotton {
        border-bottom: 1px solid red !important;
    }

    .select-row {
        background-color: #edffd8;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Create Best Rate Master
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <label> Category Name</label>
                                <div style="display:flex">
                                    <select id="ddlCategory" class="form-control mb-3"></select>
                                    <button id="btnSearch" class="btn btn-primary mb-3" style="float: right;width:30%; margin-left: 10px;" onclick="GetItemList()"> <i class="fa fa-search"></i>&nbsp;Search</button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label> Item Name</label>
                                <div style="display:flex">
                                    <select id="ddlItem" class="form-control mb-3"></select>
                                    <button id="btnSearch" class="btn btn-primary mb-3" style="float: right;width:30%; margin-left: 10px;" onclick="GetItemsWisePackList()"> <i class="fa fa-search"></i>&nbsp;Get</button>
                                    <button id="btnExcel" class="btn btn-warning mb-3" style="float: right;width:30%; margin-left: 10px;" onclick="DownloadExcel(this)"> <i class="fa fa-file-excel"></i>&nbsp;Excel</button>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="background-color:#e3e3e3;margin: 3px 0px 0px 0px;">
                            <div class="col-md-12">
                                <label>Manual Rate</label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:30vh;overflow:auto;border:1px solid #2d82ff">
                                    <table class="table table-bordered" id="tblReport">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th style="width:20%">Pack Type</th>
                                                <th style="width:10%;">Best Rate</th>
                                                <th style="width:30%">Vender Name</th>
                                                <th style="width:30%">Manufacturer Name</th>
                                                <th style="width:5%;text-align:center">Edit</th>
                                                <th style="width:5%;text-align:center">Cmd</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                        <div class="row" style="background-color:#cfcfcf;margin: 2px 0px 3px 0px;">
                            <div class="col-md-12">
                                <label> Systematic Rate</label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:30vh;overflow:auto;border:1px solid #2d82ff">
                                    <table class="table table-bordered" id="tblReportInfo">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th style="width:10%">Pack Type</th>
                                                <th style="width:10%;">Best Rate</th>
                                                <th style="width:25%">Vender Name</th>
                                                <th style="width:25%">Item Name</th>
                                                <th style="width:25%">Manufacturer Name</th>
                                                <th style="width:5%;text-align:center">Cmd</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


