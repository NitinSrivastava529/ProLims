
@{
    ViewBag.Title = "ClientMaster";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/GeneralStore/JsModule/ClientMaster.js"></script>
<script src="~/JsModule/FileSaver.min.js"></script>
<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }


    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }



    .form-group {
        margin-bottom: 5px;
    }

    hr {
        margin: 5px;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }


    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .select-row {
        background-color: #a1f1a4;
    }

    .card-body {
        padding: 10px 10px;
        color: var(--default-text-color);
    }

    .text-red {
        color: #dd4b39 !important;
    }

    .text-blue {
        color: #0073b7 !important;
    }

    .border-imp {
        border-bottom: 2px solid red !important;
    }

    .text-green {
        color: #054608 !important;
    }

    .select2-container {
        box-sizing: border-box;
        display: inline-block;
        margin: 0;
        position: relative;
        vertical-align: middle;
        border: 1px solid #86b3de;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-6">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Client list
                        </div>

                    </div>
                    <hr />
                    <div class="card-body">

                        <div class="row">
                            <div class="col-md-12">
                                <input type="text" id="txtSearch" class="form-control" autocomplete="off" placeholder="Search Package" style="border:1px solid #86b3de;margin-top: 5px;">
                                <div class="table-responsive" style="height:70vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblReport">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th style="text-align:center;width:5%">Action</th>
                                                <th>Client Name</th>
                                                <th>Client Type</th>
                                                <th>Paymode</th>
                                                <th style="text-align:center;width:5%">Edit</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Add Client
                        </div>
                        <div class="col-md-9">
                            <button type="submit" id="btnExcel" class="btn btn-xs btn-primary" style="padding:1px 5px;float:right;margin-left: 10px;" onclick="DownloadExcel(this)">Excel</button>
                            <button type="submit" id="btnpdf" class="btn btn-xs btn-success" style="padding:1px 5px;float:right;width:100px" onclick="DownloadPdf(this)">Rate List Pdf</button>
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-12 form-group">
                                <label>Test Processing Unit Name</label>
                                <select id="ddlUnit" class="form-control" style="border:1px solid #86b3de"></select>
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>Client Name</label>
                                <input type="text" id="txtClientName" class="form-control" style="border:1px solid #86b3de" placeholder="Enter Client Name" />
                                <input type="hidden" id="hidClientId" />
                            </div>
                            <div class="col-sm-3 form-group">
                                <label>Client Type</label>
                                <select id="ddlClientType" class="form-control" style="border:1px solid #86b3de">
                                    <option value="0">Select</option>
                                    <option value="B2B">B2B</option>
                                </select>
                            </div>
                            <div class="col-sm-3 form-group">
                                <label>Client Group Name</label>
                                <select id="ddlClientGroupName" class="form-control" style="border:1px solid #86b3de">
                                    <option value="0">Select</option>
                                    <option value="Chandan">Chandan</option>
                                    <option value="JeenaSikho">Jeena Sikho </option>
                                </select>
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>Payment Type</label>
                                <select id="ddlPaymentType" class="form-control" style="border:1px solid #86b3de">
                                    <option value="0">select</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Credit">Credit</option>
                                </select>
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>PINCode </label>
                                <input type="text" id="txtPINCode" class="form-control" style="border:1px solid #86b3de" placeholder="Enter Pin code" />
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>State Name</label>
                                <select id="ddlState" class="form-control" style="border:1px solid #86b3de"></select>
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>City Name</label>
                                <select id="ddlCity" class="form-control" style="border:1px solid #86b3de"></select>
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>Addess </label>
                                <input type="text" id="txtAddress" class="form-control" style="border:1px solid #86b3de" placeholder="Enter Address" />
                            </div>


                            <div class="col-sm-6 form-group">
                                <label>Email</label>
                                <input type="text" id="txtEmail" class="form-control" style="border:1px solid #86b3de" placeholder="Enter Email" />
                            </div>

                            <div class="col-sm-6 form-group">
                                <label>MRP Rate List</label>
                                <select id="ddlMRPRateList" class="form-control" style="border:1px solid #86b3de"></select>
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>Client Rate List</label>
                                <select id="ddlClientRateList" class="form-control" style="border:1px solid #86b3de"></select>
                            </div>


                            <div class="col-sm-4 form-group">
                                <label>Credit Limit </label>
                                <input type="text" id="txtCreditLimit" class="form-control" value="0" style="border:1px solid #86b3de" />
                            </div>
                            <div class="col-sm-4 form-group">
                                <label>Credit Days </label>
                                <input type="text" id="txtCreditDays" class="form-control" value="0" style="border:1px solid #86b3de" />
                            </div>
                            <div class="col-sm-4 form-group">
                                <label>Tds %</label>
                                <input type="text" id="txtTdsPerc" value="0" class="form-control" style="border:1px solid #86b3de" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div style="display:flex;margin-top:3%">
                                    <button type="submit" id="btnIdDose" class="btn btn-xs btn-success" style="margin-left:10px" onclick="IDDoseInsertData()"> Save ITDose</button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div style="display:flex;float:right;margin-top:3%">
                                    <button type="submit" class="btn btn-xs btn-warning" onclick="ClearValues()">Clear</button>
                                    <button type="submit" id="btndaddupdate" class="btn btn-xs btn-success" style="margin-left:10px" onclick="InsertUpdateClient()">Save</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

