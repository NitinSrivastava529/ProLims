
@{
    ViewBag.Title = "UnitIssue";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<script src="~/Areas/GeneralStore/JsModule/Unit/UnitIssue.js?v2.2"></script>
<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }

    .tab-content .tab-pane {
        border: none;
        padding: 0px;
    }

    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }

    .hide {
        display: none;
    }

    .toggle {
        margin-bottom: 0 !IMPORTANT;
        margin: 0;
    }

    .form-control, button#btnMainMenu, button#btnSubMenu {
        line-height: 1 !important;
        font-size: 13px !important;
        height: 30px;
    }

    table td button, table th button {
        height: 17px;
        margin-left: 5px;
        line-height: 0;
        font-size: 11px !important;
    }

    #tblStock tbody input {
        width:100%;
        height: 18px;
        text-align:right;
        border: 1px solid #d2d5d7;
    }
    .text-right{
        text-align:right;
        padding-right:10px !important;
    }
    #tblOrders tbody input {
        width: 90%;
        text-align: right;
        height: 17px;
        font-size: 11px;
        border: 1px solid #cfcfcf;
        border-radius: 1px;
        padding-right: 3px;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-6">
                <div class="card custom-card">
                    @*<div class="card-header">
                            <div class="card-title">
                                Dispatch Processing
                            </div>
                        </div>*@
                    <div class="card-body">
                        <div class="row g-6">
                            <div class="col-sm-12">
                                <div class="row">
                                    <div class="col-md-5 mb-2">
                                        <select class="form-control" id="ddlUnit">
                                            <option value="ALL">All Unit</option>
                                        </select>
                                    </div>
                                    <div class="col-md-7 mb-2" style="padding: 0px;">
                                        <div style="width: 39%;display:flex;align-items:center">
                                            <input type="date" id="txtFrom" class="form-control" />&nbsp;
                                            <input type="date" id="txtTo" class="form-control" />&nbsp;
                                            <button id="btnGet" onclick="PendingIssue()" style="margin-left:5px;white-space:pre" class="btn btn-primary btn-sm"><i class="fa fa-check-circle">&nbsp;</i>Get</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="table-responsive" style="height:460px;overflow:auto;border:1px solid #ddd">
                                        <label style="width: 100%;background: #0b95f2;padding: 1px 5px;color: #fff;">Pending Issue Items</label>
                                        <table class="table text-nowrap" id="tblPendingIssue">
                                            <thead>
                                                <tr>
                                                    <th scope="col" style="width:1%;padding-right:10px;">CMD</th>
                                                    <th scope="col">Item Id</th>
                                                    <th scope="col">Item Name</th>
                                                    <th scope="col">Pack Type</th>
                                                    <th scope="col">O.Qty</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card custom-card">
                    <div class="modal fade" id="formmodal" tabindex="-1"
                         aria-labelledby="exampleModalLabel" aria-hidden="true">
                    </div>
                    <div class="card-body">
                        <div class="row g-6">
                            <div class="col-sm-12">                           
                                <div class="row">
                                    <div class="col-md-12" style="height:300px">
                                        <div class="table-responsive" style="height:290px;overflow:auto;border:1px solid #ddd">
                                            <label style="width: 100%;background: #0b95f2;padding: 1px 5px;color: #fff;">Stock Details of Items</label>
                                            <table class="table table-bordered" id="tblStock">
                                                <thead>
                                                    <tr>
                                                        <th>Master Key Id</th>
                                                        <th>Item Id</th>
                                                        <th>Pack Type</th>
                                                        <th>Batch No</th>
                                                        <th>Exp. Date</th>
                                                        <th>Stock</th>
                                                        <th style="width:10%">Qty</th>
                                                        <th style="width:1%">CMD</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="col-md-12" style="height:200px">
                                        <div class="table-responsive" style="height:190px;overflow:auto;border:1px solid #ddd">
                                            <label style="width: 100%;background: #0b95f2;padding: 1px 5px;color: #fff;">Issued Items</label>
                                            <table class="table text-nowrap" id="tblIssuedItem">
                                                <thead>
                                                    <tr>
                                                        <th scope="col" style="width:1%;padding-right:10px;">#</th>
                                                        <th scope="col">Item Id</th>
                                                        <th scope="col">Item Name</th>
                                                        <th scope="col">Pack Type</th>
                                                        <th scope="col">Issue Qty</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

