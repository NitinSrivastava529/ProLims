
@{
    ViewBag.Title = "ManualPO";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<script src="~/Areas/GeneralStore/JsModule/Warehouse/ManualPO.js?v1.1"></script>
<style>
    #tblUnCompleteIndent th {
        white-space: pre;
    }

    hr {
        margin-top: 2px;
        border: 1px solid #726f6f;
        margin-bottom: 4px;
    }

    .mb-3 {
        margin-bottom: 10px !important;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    tr[data-isAmount] td {
        background: #c1e5c1;
    }

    .cat-group {
        background-color: #ddd;
    }

        .cat-group .total {
            float: right;
            margin-right: 5px;
        }

    #tblInfo th, #tblInfo td {
        border: none;
        font-size: 12px;
        line-height: 19px;
        background: #f3f3f3;
        padding: 2px 6px;
    }

    .table thead td, .table thead th {
        font-weight: 700;
        font-size: 12px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom-width: 1px;
        border-top-width: 0;
        padding: 5px;
    }

    .table td, .table th {
        padding: 5px;
        vertical-align: middle;
        line-height: 1.462;
        font-size: 0.875rem;
    }

    .select-row {
        background-color: #ccc;
    }
</style>
<style>
    .ui-state-hover, .ui-widget-content .ui-state-hover, .ui-widget-header .ui-state-hover, .ui-state-focus, .ui-widget-content .ui-state-focus, .ui-widget-header .ui-state-focus {
        /*border: 1px solid #cdd5da;*/
        background: DodgerBlue !important;
        color: #fff !important;
        max-width: 260px;
    }

    .ui-autocomplete {
        padding: 0;
        max-width: 260px;
        max-height: 320px;
        overflow: scroll;
        overflow-x: hidden;
    }

    .ui-menu-item {
    }

    .ui-menu .ui-menu-item a {
        font-family: inherit;
        padding: 5px 12px;
        font-size: 10px;
        color: #2b2f33;
        font-family: Arial;
    }

    .selected {
        background: DodgerBlue !important;
        color: #fff;
    }

    .autocomplete {
        /*the container must be positioned relative:*/
        position: relative;
        display: inline-block;
    }

    #ItemList {
        box-shadow: 1px 1px 1px #ececec;
        border: 0.5px solid #ececec;
        width: 300px;
        max-width: 300px;
        max-height: 361px;
        /*overflow: scroll;*/
        overflow-x: hidden;
        position: absolute;
        z-index: 1;
        background: #fff;
        /*top: 50px;*/
    }

    #ItemListDetails {
        box-shadow: 1px 1px 1px #ececec;
        /*border: 0.5px solid #ececec;*/
        width: 495px;
        max-width: 410px;
        max-height: 55vh;
        overflow: hidden;
        overflow-x: hidden;
        position: absolute;
        z-index: 1;
        background: #fff;
        top: 122px;
        left: 253px;
        overflow: auto;
    }

        #ItemListDetails thead {
            border-bottom: 1px dashed#e8e8e8;
        }

    .bg-blue {
        background: #007ffb;
        color: #fff;
        border: none;
    }

    #ItemList table {
        font-size: 11px;
        line-height: 22px;
        width: 100%;
    }

    #ItemListDetails table {
        font-size: 11px;
        line-height: 22px;
        width: 100%;
    }

    .btnfa {
        text-align: center;
        cursor: pointer;
        font-size: 16px !important;
        padding: 1px !important;
    }

    #ItemList table td, #ItemListDetails table td, #ItemListDetails table th {
        padding: 1px 0px 0px 10px;
    }

    #ItemList table tbody tr, #ItemListDetails table tbody tr {
        border-bottom: 0.1px solid #eaeaea;
    }

    #tblUnCompleteIndent {
        width: 100%;
        background: #fff;
        height: 49vh;
        display: block;
        /*border: 1px solid #ccc;*/
        overflow: auto;
    }

    .focus {
        border-color: red;
    }

    #tblUnCompleteIndent tbody tr td {
        border-bottom: 1px solid #f1f1f1 !important;
    }

        #tblUnCompleteIndent tbody tr td:nth-child(1) {
            width: 5% !important;
        }

    #tblUnCompleteIndent th:nth-child(1) {
        width: 1% !important;
    }

    .form-control[disabled], .form-control[readonly], fieldset[disabled] .form-control, input[disabled], select[disabled], textarea[disabled] {
        cursor: not-allowed;
        opacity: .65;
        background: #deeffd;
        filter: alpha(opacity: 65);
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Create Manual PO
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">                             
                                <span class="text-primary">
                                    Note : Be Sure to Complete PO for Displaying in Stock.
                                </span>
                            </div>
                            <div class="col-md-2">                             
                            </div>
                            <div class="col-md-4">

                                <label>PO No.</label>
                                <div class="fileinput fileinput-new input-group" data-provides="fileinput">
                                    <input type="text" id="txtPoNo" class="form-control mb-3 input_pass" disabled value="New" placeholder="Indent No..">
                                    <span id="btnCompleteIndent" onclick="GenManualPO('GenManual:Done')" class="btn btn-primary" style="height: 35px;">
                                        Complete
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="fileinput fileinput-new input-group" data-provides="fileinput">
                                    <div class="autocomplete" style="width:100%;">
                                        <label>Product Name</label>
                                        <input type="text" id="txtItemName" class="form-control input_pass" value="" autocomplete="off" placeholder="Product Name" />
                                    </div>

                                </div>
                                <div id="ItemList" style="display:none">
                                    <table id="tblnavigate">
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label>Pack Type</label>
                                <div class="fileinput fileinput-new input-group" data-provides="fileinput">
                                    <select id="ddlPack" class="form-control"></select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label>Qty</label>
                                <div class="d-flex align-items-start mb-3">
                                    <input type="text" id="txtQty" placeholder="Qty" class="form-control mb-3  input_pass">                        
                                    <span id="btnSaveOrder" onclick="GenManualPO('GenManual:Insert')" class="btn btn-success" style="height: 35px;float:right;margin-left: 5px;width: 50%;">
                                        Add Item
                                    </span>
                                </div>
                            </div>                          
                        </div>
                        <hr />
                        <div class="row">
                            <div id="ItemListDetails" style="display:none">
                                <table id="tblItemList" class="">
                                    <thead style="background-image: linear-gradient(#3867ad, #043378);color: white;" class="tofixed">
                                        <tr>
                                            <th style="width:10%">ItemId</th>
                                            <th>Pack Type</th>
                                            <th>Pack Quantity</th>
                                            <th>Unit Stock</th>
                                            <th>Unit Pendency</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="table table-responsive">
                                    <table id="tblUnCompletePO" class="table table-bordered ">
                                        <thead style="background-image: linear-gradient(#3867ad, #043378);color: white;" class="tofixed">
                                            <tr>
                                                <th>Item Id</th>
                                                <th>Item Name</th>
                                                <th>Pack Type</th>
                                                <th style="width:15%">Qty</th>
                                                <th style="width:1%">CMD</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                        </div>


                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

