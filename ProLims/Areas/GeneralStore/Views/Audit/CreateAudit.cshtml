
@{
    ViewBag.Title = "CreateAudit";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/GeneralStore/JsModule/AuditModule/CreateAudit.js"></script>
<style>
    .table td, .table th {
        padding: 5px;
        vertical-align: middle;
        line-height: 14px;
        font-size: 13px;
    }

    .table thead td, .table thead th {
        font-weight: 600;
        font-size: 12px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom-width: 1px;
        border-top-width: 0;
        padding: 5px;
    }

    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .borderbotton {
        border-bottom: 1px solid red !important;
    }

    .select-row {
        background-color: #edffd8;
    }
</style>

<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-6">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Create Audit
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="fileinput fileinput-new input-group" style="display:flex" data-provides="fileinput">
                                    <textarea class="form-control mb-3" id="txtRemark" rows="2" placeholder="Remark"></textarea>
                                    <button id="btnSave" onclick="InsertAuditMaster()" class="btn btn-success mb-3" style="float:right">Submit</button>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-12">
                                <div class="fileinput fileinput-new input-group" data-provides="fileinput">
                                    <input type="text" id="txtSearch" class="form-control input_pass" onkeyup="return SearchDepartment(this)" placeholder="Search Audit..">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:60vh;overflow:auto;border:1px solid #2d82ff">
                                    <table class="table table-bordered" id="tblAuditMaster">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>Audit No</th>
                                                <th>Remark</th>
                                                <th>Created On</th>
                                                <th style="width: 10%;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

