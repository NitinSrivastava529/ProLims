
@{
    ViewBag.Title = "JsShareInfo";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<script src="~/Areas/Diagnostics/JsModule/JsShareInfo.js?v1.1"></script>
<script src="~/JsModule/FileSaver.min.js?v1.1"></script>
<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }
    th span {
        color: yellow;
        font-size: 13px;
        border: 1px solid #ddd;
        padding: 1px 5px;
        margin-left: 8px;
        border-radius: 24px;
    }
    .text-right {
        text-align: right;
    }

    .hidden {
        display: none;
    }

    .blockUI {
        pointer-events: none;
        opacity: 0.5;
    }

    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }



    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 5px !important;
    }

    .select-row {
        background-color: #cde9ff;
    }

    .vtimeline .timeline-wrapper {
        display: block;
        margin-block-end: 20px;
        position: relative;
        width: 100%;
        padding-inline-end: 70px;
    }

        .vtimeline .timeline-wrapper .timeline-badge {
            width: 41px;
            height: 50px;
            position: absolute;
            inset-block-start: 5px;
            inset-inline-start: calc(50% - 20px);
            z-index: 0;
            border: 0 solid #fff;
            border-radius: 50%;
            margin-top: -5px;
        }

    .circleload {
        content: '';
        position: absolute;
        width: 30px;
        height: 30px;
        right: -17px;
        background-color: #2196F3;
        border: 4px solid #aadbf1;
        /* top: 15px; */
        border-radius: 50%;
        z-index: 1;
    }

    .vtimeline:before {
        inset-block-start: 0;
        inset-block-end: 0;
        position: absolute;
        content: " ";
        width: 3px;
        background-color: #b5deff;
        inset-inline-start: 20%;
        margin-inline-start: -1.5px;
    }

    .vtimeline .timeline-wrapper .timeline-badge {
        width: 43px;
        height: 43px;
        position: absolute;
        inset-block-start: 5px;
        inset-inline-start: calc(20% - 20px);
        z-index: 0;
        border: 0 solid #fff;
        border-radius: 50%;
        margin-top: -5px;
    }

    .vtimeline .timeline-wrapper .timeline-panel {
        border-radius: 5px;
        padding: 20px;
        position: relative;
        background: #deeffd;
        box-shadow: none;
        width: 75%;
        margin-inline-start: 15%;
    }

    .vtimeline .timeline-wrapper.timeline-inverted {
        padding-inline-end: 0;
        padding-inline-start: 90px;
    }

    .text-muted {
        color: black !important;
    }

    .badge {
        padding: 5px;
        font-size: 13px;
        /* line-height: 0; */
        /* font-weight: 200; */
        border-radius: .1875rem;
    }

    .rounded-pill {
        border-radius: var(--bs-border-radius-pill) !important;
    }

    #txtStatus {
        background: #f7e6b0;
        padding: 6px 16px;
        border-radius: 40px;
        margin-left: 20px;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Jeena Sikho Share Info
                        </div>

                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div style="display:flex">
                                    <input type="month" id="txtMonth" class="form-control mb-3" />&nbsp;
                                    <button type="button" class="btn btn-primary mb-3" style="margin:0 2px;white-space:pre" id="btnSearch" onclick="JS_Payable();">Get Share</button>                                   
                                </div>
                            </div>
                            <div class="col-md-8">
                                <label id="txtStatus"></label>
                                <button type="button" class="btn btn-warning mb-3" style="margin:0 2px;float:right;" id="btnPresertve" onclick="Preserve();">Preserve</button>
                                <button type="button" class="btn btn-info mb-3" style="margin:0 2px;white-space:pre;margin-left:10px;float:right;" id="btnxl" onclick="DownloadExcel(this);">Excel</button>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:60vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblShare">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>#</th>
                                                <th>Client Name</th>
                                                <th class="text-right">Mrp Total<span id="mrpTotal"></span></th>
                                                <th class="text-right">Share<span id="share"></span></th>
                                                <th class="text-right">Adl Discount<span id="adlDiscount"></span></th>
                                                <th class="text-right">Credit Sale<span id="creditSale"></span></th>
                                                <th class="text-right">Net Payable<span id="netPayable"></span></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


