
@{
    ViewBag.Title = "InvestigationMaster";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/Diagnostics/JsModule/InvestigationMaster.js"></script>
<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }


    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }



    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .form-group {
        margin-bottom: 5px;
    }

    .select-row {
        background-color: #d8f7b4;
    }

    /*.select2-container {
        box-sizing: border-box;
        display: inline-block;
        margin: 0;
        position: relative;
        vertical-align: middle;
        border: 1px solid #86b3de;
    }*/
    .border-imp {
        border: 1px solid #86b3de;
    }

    .dropdown-menu {
        height: 40vh;
        overflow: auto;
        position: absolute;
        inset: 0px auto auto 0px;
        margin: 0px;
        transform: translate(0px, 37px);
        width: 100%;
    }

    .dropdown-item {
        color: var(--default-text-color);
        white-space: unset;
        padding: 10px;
        font-size: 15px;
        font-weight: 400;
    }

    .card-body {
        padding: 10px;
        color: var(--default-text-color);
    }

    .select2-container {
        box-sizing: border-box;
        display: inline-block;
        margin: 0;
        position: relative;
        vertical-align: middle;
        border: 1px solid #86b3de;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-3">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Investigation  Details
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-xs btn-warning" style="padding:0px 5px;width:100%" onclick="ClearValues()">New</button>
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label>Category</label>
                                    <div style="display:flex">
                                        <select id="ddlTestSubCategory" class="form-control"></select>
                                        <button type="submit" class="btn btn-xs btn-success" onclick="SearchBySubCategory()" style="margin-left:10px"><i class="fa fa-search fa-lg"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:69vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblTestDetails">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th style="width:1%">cmd</th>
                                                <th style="width:1%">TestCode</th>
                                                <th><input type="text" id="txtSearch" class="form-control" autocomplete="off" placeholder="Search Test Name" style="width:90%;border:1px solid #86b3de" /></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Import From LIS
                            <button id="get-started" class="btn btn-xs btn-primary" data-bs-toggle="modal" data-bs-target="#modalSearch" style="padding: 0px 5px;"><i class="fa fa-plus"></i></button>
                        </div>
                        <div class="col-md-4">
                            <input type="button" id="btnInvestigationSample" style="padding:0px 5px;width:100px; margin-bottom: 2px" class="btn btn-success" value="Save" onclick="InsertUpdateInvestigation()" />
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-12 form-group">
                                <label>Sub Category</label>
                                <select id="ddlSubCategory" class="form-control border-imp"></select>
                            </div>
                            <div class="col-sm-6 form-group" id="divExternalCode">
                                <label>Ext Code</label>
                                <input type="text" id="txtExtCode" class="form-control border-imp" disabled />
                            </div>
                            <div class="col-sm-6 form-group" id="divInvestCode">
                                <label>Investigation id</label>
                                <input type="text" id="txtInvestCode" class="form-control border-imp" disabled />
                            </div>
                            <div class="col-sm-12 form-group" id="divInvestType">
                                <label>Investigation Type</label>
                                <select id="ddlInvestType" class="form-control border-imp">
                                    <option value="0">--Please Select--</option>
                                    <option value="Investigation">Investigation</option>
                                    <option value="Profile">Profile</option>
                                </select>
                            </div>
                            <div class="col-md-12 form-group">
                                <label>Investigation Name</label>
                                <input type="text" id="txtInvestName" class="form-control border-imp" placeholder="Enter Investigation Name" />
                            </div>
                            <div class="col-md-12 form-group">
                                <label>Rate</label>
                                <input type="text" id="txtRate" data-int data-count="12" class="form-control border-imp" placeholder="Enter Rate" />
                            </div>
                            <div class="col-md-12 form-group">
                                <label>Sample Option</label>
                                <select id="ddlSampleoption" class="form-control border-imp">
                                    <option value="0">--Please Select--</option>
                                    <option value="Required">Required</option>
                                    <option value="Not Required">Not Required</option>
                                </select>
                            </div>
                            @*<div class="col-md-12 form-group">
                                    <label>Sample Links</label>
                                    <select class="form-control" data-placeholder="SampleData" name="choices-multiple-remove-button" id="ddlSamplesdata" multiple></select>
                                </div>*@
                            <div class="col-sm-12 form-group">
                                <label>Default Sample</label>
                                <input id="txtDefaultSample" class="form-control border-imp" disabled />
                                @*<select id="ddlDefaultSample" class="form-control">
                                        <option value="0">select</option>
                                    </select>*@
                            </div>
                            <br />
                            <div class="col-sm-12 form-group">
                                <label>.</label>
                                <div style="display:flex">
                                    <label> Is Popular</label>
                                    <input type="checkbox" style="width: 20px;height: 20px;margin-left:15px" id="chkIsOutSource" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-xl-3">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Package  Details
                        </div>
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-xs btn-success" style="padding:0px 5px; width: 100%; margin-bottom: 2px;" onclick="ImportPackageData()">Import From LIS</button>
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:77vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblPackageDetails">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>Package Id</th>
                                                <th><input type="text" id="txtSearch1" class="form-control" autocomplete="off" placeholder="Search Test Name" style="width:90%;border:1px solid #86b3de" /></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Sample  Details
                        </div>
                        <div class="col-md-5">
                            <button type="submit" class="btn btn-xs btn-success" id="btnSample" style="padding:0px 5px;width:100%" onclick="ImportSampleData()">Import Sample</button>
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:77vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblSampleDetails">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>Sample id</th>
                                                <th><input type="text" id="txtSearch2" class="form-control" autocomplete="off" placeholder="Search Test Name" style="width:90%;border:1px solid #86b3de" /></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>


<div class="row">
    <div class="col-xl-12">
        <div class="card-body">
            <div class="modal fade" id="modalSearch" tabindex="-1"
                 aria-labelledby="exampleModalXlLabel" style="display:none;" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title" id="exampleModalXlLabel">
                                Search
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-sm-2">
                                    <label>Report Type :</label>
                                </div>
                                <div class="col-sm-4">
                                    <select id="ddlstatus" class="form-control">
                                        <option value="select">select</option>
                                        <option value="ByTestCode">Package</option>
                                        <option value="">Investigation</option>
                                    </select>
                                </div>
                                <div class="col-sm-6">
                                    <div style="display:flex">
                                        <input type="text" id="txtSearchCode" class="form-control" style="border:1px solid #86b3de;" placeholder="Search Code" />
                                        <button type="submit" id="btnSearchCode" style="margin-left:10px;width:50%" class="btn btn-xs btn-success" onclick="SearchByCode()"><i class="fa fa-search">&nbsp;</i>Search Code</button>
                                    </div>
                                </div>

                                @*<div class="col-sm-4">
                                    <div style="display:flex">
                                    <input type="text" id="txtSearchText" class="form-control" style="border:1px solid #86b3de;" />
                                    <button type="submit" id="btnSearchText" class="btn btn-xs btn-success" style="margin-left:10px;width:50%" onclick="SearchByName()"><i class="fa fa-search">&nbsp;</i>Search Text</button>
                                    </div>
                                    </div>*@


                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div style="height:40vh;overflow:auto;margin-top:5px;border: 1px solid #2478a9;">
                                        <table class="table table-bordered" id="tblInvestgationDetails">
                                            <thead style="background: #2d82ff;color: white;" class="tofixed">
                                                <tr>

                                                    <th style="width:15%">Investigation Id</th>
                                                    <th style="width:15%">Test code</th>
                                                    <th style="width:25%">Test Name</th>
                                                    <th style="width:25%">Sub Category Name</th>
                                                    <th style="width:5%">CMD</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>