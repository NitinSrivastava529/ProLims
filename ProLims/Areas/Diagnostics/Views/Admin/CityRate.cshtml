
@{
    /**/

    ViewBag.Title = "CityRate";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/Diagnostics/JsModule/CityRate.js"></script>
<script src="~/JsModule/FileSaver.min.js"></script>

<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }


    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }



    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .select-row {
        background-color: #d8f7b4;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            City Rate List
                        </div>
                        <div class="col-md-9">
                            <button class="btn btn-primary" id="btnfilter" style="width:100px; float: right;padding:1px;" data-bs-toggle="modal" data-bs-target="#ModalExcelUpload">New Entry</button>
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div style="display:flex">
                                    <input type="text" class="form-control" id="txtSearch" placeholder="Search..." />
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:70vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblReport">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>Rate Id</th>
                                                <th>Rate Name</th>
                                                <th> Rate Type</th>
                                                <th style="width:15%;text-align:center"> Excel</th>
                                                <th style="width:15%;text-align:center"> Uplaod</th>
                                                <th style="width:5%;text-align:center"> Pdf</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card-body">
            <div class="modal fade" id="ModalExcelUpload" tabindex="-1"
                 aria-labelledby="exampleModalXlLabel" style="display:none;" aria-hidden="true">
                <div class="modal-dialog modal-md">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title" id="exampleModalXlLabel">
                                City Master
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div style="background: rgb(236 237 239);padding:5px;border-radius: 3px;">
                                <div class="row">
                                    <div class="col-md-12">
                                        <label>City Name</label>
                                        <div style="display:flex">
                                            <select class="form-control" id="ddlCity"></select>
                                            <button id="btnSave" class="btn btn-primary" style="width:30%" onclick="SubmitCity()"><i class="fa fa-save"></i>&nbsp;Submit</button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
