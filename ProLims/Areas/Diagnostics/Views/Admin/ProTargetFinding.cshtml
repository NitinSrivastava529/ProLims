
@{
    ViewBag.Title = "ProTargetFinding";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/Diagnostics/JsModule/ProTargetFinding.js"></script>
<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }


    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }



    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .select-row {
        background-color: #f0fbe3;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-8">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Pro List
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div style="display:flex">
                                    <input id="txtSearch" class="form-control mb-3" placeholder="Search..." />
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:65vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblReport">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th style="width:15%">Pro Code</th>
                                                <th>Pro Name</th>
                                                <th style="width:10%;text-align:center">CMD</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card-body">
            <div class="modal fade" id="modelmonthList" tabindex="-1"
                 aria-labelledby="exampleModalXlLabel" style="display:none;" aria-hidden="true">
                <div class="modal-dialog modal-md">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title" id="exampleModalXlLabel">
                                Month List
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="col-md-12">
                                <label>
                                    Financial year
                                </label>
                                <div style="display:flex">
                                    <select id="ddlfinancial" class="form-control mb-3">
                                        <option value="Select">Select</option>
                                        <option value="2526" selected>2526</option>
                                        <option value="2627">2627</option>
                                        <option value="2728">2728</option>
                                        <option value="2829">2829</option>
                                        <option value="2930">2930</option>
                                        <option value="3031">3031</option>
                                    </select>
                                    <button id="btnGet" class="btn btn-primary mb-3" type="button" style="width:100px;" onclick="GetDetails()"><span class="fa fa-search"></span>&nbsp;Get</button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="table-responsive">
                                        <table class="table table-bordered" id="tblReportInfo">
                                            <thead style="background-image: linear-gradient(#3867ad, #043378);color: white;" class="tofixed">
                                                <tr>
                                                    <th>Month Name</th>
                                                    <th style="width:30%;text-align:center"><input type='text' style='color:black;text-align: center;' class="form-control" id="txtamount" data-int /></th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <button id="btnSave" class="btn btn-success" onclick="InsertRate()" style="float: right;margin-top: 5px;">Save</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
