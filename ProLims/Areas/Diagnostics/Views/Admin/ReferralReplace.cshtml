
@{
    ViewBag.Title = "ReferralReplace";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/Diagnostics/JsModule/ReferralReplace.js"></script>
<style>
    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }

    .tab-content .tab-pane {
        border: none;
        padding: 0px;
    }

    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }

    .hide {
        display: none;
    }

    .toggle {
        margin-bottom: 0 !IMPORTANT;
        margin: 0;
    }

    .form-control, button#btnMainMenu, button#btnSubMenu {
        line-height: 1 !important;
        font-size: 13px !important;
        height: 35px;
    }

    table td button, table th button {
        height: 17px;
        margin-left: 5px;
        line-height: 0;
        font-size: 11px !important;
    }

    #tblStock tbody input {
        width: 100%;
        height: 18px;
        text-align: right;
        border: 1px solid #d2d5d7;
    }

    .text-right {
        text-align: right;
        padding-right: 10px !important;
    }

    #tblOrders tbody input {
        width: 90%;
        text-align: right;
        height: 17px;
        font-size: 11px;
        border: 1px solid #cfcfcf;
        border-radius: 1px;
        padding-right: 3px;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .select-row {
        background-color: #bbd2e5;
    }

    .search-section {
        border: 1px solid #ddd;
        background: #efefef;
        padding: 5px;
        margin: 0px;
        text-align: left;
        margin-left: 10px;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-10">
                <div class="card custom-card">
                    <div class="card-header">
                        <div class="card-title">
                            Referral Replace
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <label>Client Name</label>
                                <select class="form-control" id="ddlClient" onchange="DoctorList()"></select>
                            </div>
                            <div class="col-md-3">
                                <label>From</label>
                                <input type="date" id="txtFrom" class="form-control" />&nbsp;
                            </div>
                            <div class="col-md-4">
                                <label>To</label>
                                <div style="display:flex;">
                                    <input type="date" id="txtTo" class="form-control" />&nbsp;
                                    <button id="btnGet" onclick="GetReport(this)" style="margin-left:5px;white-space:pre" class="btn btn-primary btn-sm"><i class="fa fa-check-circle">&nbsp;</i>Get</button>

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:50vh;overflow:auto;border:1px solid #ddd;margin-bottom:10px">
                                    <table class="table table-bordered" id="tblReport">
                                        <thead class="tofixed">
                                            <tr>
                                                <th style="width:5%;text-align:center"><input type="checkbox" id="chkallshift" /></th>
                                                <th scope="col">ClientName</th>
                                                <th scope="col">UHID</th>
                                                <th scope="col">VisitNo</th>
                                                <th scope="col">Visitdate</th>
                                                <th scope="col">Patient Name</th>
                                                <th scope="col">AgeInfo</th>
                                                <th scope="col">Gender</th>
                                                <th scope="col">Mobile No</th>

                                                <th scope="col">DoctorName</th>

                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-8 search-section">
                                    <label>Doctor Name</label>
                                    <div style="display:flex">
                                        <select class="form-control" id="ddlDoctorName"></select>
                                        <button id="btnsave" class="btn btn-success" onclick="LinkDoctorPatient()">Submit</button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
