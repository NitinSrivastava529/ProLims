
@{
    ViewBag.Title = "ItemWiseRateList";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/Diagnostics/JsModule/ItemWiseRateList.js?v1.1"></script>
<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }
    #tblRateList tbody input {
        width: 100%;
        text-align: right;
        height: 20px;
    }

    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }



    .form-group {
        margin-bottom: 5px;
    }

    hr {
        margin: 5px;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }


    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .select-row {
        background-color: #a1f1a4;
    }

    .card-body {
        padding: 10px 10px;
        color: var(--default-text-color);
    }

    .text-red {
        color: #dd4b39 !important;
    }

    .text-blue {
        color: #0073b7 !important;
    }

    .border-imp {
        border-bottom: 2px solid red !important;
    }

    .text-green {
        color: #054608 !important;
    }

    .select2-container {
        box-sizing: border-box;
        display: inline-block;
        margin: 0;
        position: relative;
        vertical-align: middle;
        border: 1px solid #86b3de;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-6">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Item Wise Rate List
                        </div>

                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">                          
                                <div class="table-responsive" style="height:70vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblItem">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>                                             
                                                <th style="width:10%">Item Id</th>
                                                <th><input type="text" id="searchItem" onkeyup="searchTable('searchItem','tblItem')" placeholder="search item" /></th>                                         
                                                <th style="text-align:center;width:8%">CMD</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                           Manage Rate List
                        </div>
                        @*<div class="col-md-9">
                            <button type="submit" id="btnExcel" class="btn btn-xs btn-primary" style="padding:1px 5px;float:right;margin-left: 10px;" onclick="DownloadExcel(this)">Excel</button>
                            <button type="submit" id="btnpdf" class="btn btn-xs btn-success" style="padding:1px 5px;float:right;width:100px" onclick="DownloadPdf(this)">Rate List Pdf</button>
                        </div>*@
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:70vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblRateList">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>                                               
                                                <th>RateList Id</th>
                                                <th>Rate List Name</th>
                                                <th style="width:10%"><input type="text" onkeyup="$('#tblRateList tbody input').val($(this).val())" placeholder="Rate" /></th>                                            
                                                <th style="text-align:center;width:8%">CMD</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


