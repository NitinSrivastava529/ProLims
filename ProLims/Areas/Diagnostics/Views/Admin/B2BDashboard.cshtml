            <script>
                // Set today's date & last sync time
                function formatDate(date) {
                    const d = new Date(date);
                    const pad = (n) => String(n).padStart(2, "0");
                    return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}`;
                }

                (function initDates() {
                    const today = new Date();
                    const prior = new Date();
                    prior.setDate(today.getDate() - 15);

                    document.getElementById("todayDate").textContent = formatDate(today);
                    document.getElementById("fromDate").valueAsDate = prior;
                    document.getElementById("toDate").valueAsDate = today;

                    const lastSync = document.getElementById("lastSync");
                    const timeStr = today.toTimeString().slice(0, 5);
                    lastSync.textContent = `Updated — ${formatDate(today)} • ${timeStr}`;
                })();

                // Draw smooth line chart in the trend canvas
                (function drawTrend() {
                    const canvas = document.getElementById("trendCanvas");
                    const parent = canvas.parentElement;
                    // fill entire layer
                    canvas.width = parent.clientWidth * window.devicePixelRatio;
                    canvas.height = parent.clientHeight * window.devicePixelRatio;
                    const ctx = canvas.getContext("2d");
                    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);

                    const values = [28, 31, 36, 41, 46, 52]; // pseudo monthly totals
                    const max = Math.max(...values) * 1.1;
                    const min = Math.min(...values) * 0.9;

                    const w = parent.clientWidth;
                    const h = parent.clientHeight;

                    const leftPad = 4;
                    const rightPad = 6;
                    const topPad = 8;
                    const bottomPad = 10;

                    const points = values.map((v, i) => {
                        const x = leftPad + ((w - leftPad - rightPad) * i) / (values.length - 1);
                        const norm = (v - min) / (max - min || 1);
                        const y = h - bottomPad - norm * (h - topPad - bottomPad);
                        return { x, y };
                    });

                    // gradient line
                    const grad = ctx.createLinearGradient(0, topPad, 0, h - bottomPad);
                    grad.addColorStop(0, "#22c55e");
                    grad.addColorStop(0.5, "#2dd4bf");
                    grad.addColorStop(1, "#0ea5e9");

                    ctx.lineWidth = 2;
                    ctx.strokeStyle = grad;
                    ctx.fillStyle = "rgba(45,212,191,0.16)";

                    ctx.beginPath();
                    for (let i = 0; i < points.length; i++) {
                        const p = points[i];
                        if (i === 0) {
                            ctx.moveTo(p.x, p.y);
                        } else {
                            const prev = points[i - 1];
                            const cx = (prev.x + p.x) / 2;
                            const cy = (prev.y + p.y) / 2;
                            ctx.quadraticCurveTo(prev.x, prev.y, cx, cy);
                        }
                    }
                    ctx.stroke();

                    // area fill
                    const last = points[points.length - 1];
                    ctx.lineTo(last.x, h - bottomPad);
                    ctx.lineTo(points[0].x, h - bottomPad);
                    ctx.closePath();
                    ctx.fill();

                    // dots
                    ctx.fillStyle = "#f9fafb";
                    ctx.strokeStyle = "#22c55e";
                    ctx.lineWidth = 1.4;
                    points.forEach((p, idx) => {
                        const radius = idx === points.length - 1 ? 4 : 3;
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.stroke();
                    });
                })();

                // fake refresh handler
                document.getElementById("btnRefresh").addEventListener("click", () => {
                    const btn = document.getElementById("btnRefresh");
                    const original = btn.textContent;
                    btn.textContent = "Refreshing…";
                    btn.disabled = true;
                    setTimeout(() => {
                        btn.textContent = original;
                        btn.disabled = false;
                    }, 700);
                });

                // resize chart on window resize
                window.addEventListener("resize", () => {
                    // redraw trend after small debounce
                    clearTimeout(window.__trendTimeout);
                    window.__trendTimeout = setTimeout(() => {
                        (function redrawTrend() {
                            const canvas = document.getElementById("trendCanvas");
                            const parent = canvas.parentElement;
                            canvas.width = parent.clientWidth * window.devicePixelRatio;
                            canvas.height = parent.clientHeight * window.devicePixelRatio;
                            const ctx = canvas.getContext("2d");
                            ctx.setTransform(1, 0, 0, 1, 0, 0); // reset
                            ctx.scale(window.devicePixelRatio, window.devicePixelRatio);

                            const values = [28, 31, 36, 41, 46, 52];
                            const max = Math.max(...values) * 1.1;
                            const min = Math.min(...values) * 0.9;

                            const w = parent.clientWidth;
                            const h = parent.clientHeight;
                            const leftPad = 4;
                            const rightPad = 6;
                            const topPad = 8;
                            const bottomPad = 10;

                            const points = values.map((v, i) => {
                                const x =
                                    leftPad +
                                    ((w - leftPad - rightPad) * i) / (values.length - 1);
                                const norm = (v - min) / (max - min || 1);
                                const y =
                                    h - bottomPad - norm * (h - topPad - bottomPad);
                                return { x, y };
                            });

                            const grad = ctx.createLinearGradient(0, topPad, 0, h - bottomPad);
                            grad.addColorStop(0, "#22c55e");
                            grad.addColorStop(0.5, "#2dd4bf");
                            grad.addColorStop(1, "#0ea5e9");

                            ctx.lineWidth = 2;
                            ctx.strokeStyle = grad;
                            ctx.fillStyle = "rgba(45,212,191,0.16)";

                            ctx.beginPath();
                            for (let i = 0; i < points.length; i++) {
                                const p = points[i];
                                if (i === 0) {
                                    ctx.moveTo(p.x, p.y);
                                } else {
                                    const prev = points[i - 1];
                                    const cx = (prev.x + p.x) / 2;
                                    const cy = (prev.y + p.y) / 2;
                                    ctx.quadraticCurveTo(prev.x, prev.y, cx, cy);
                                }
                            }
                            ctx.stroke();

                            const last = points[points.length - 1];
                            ctx.lineTo(last.x, h - bottomPad);
                            ctx.lineTo(points[0].x, h - bottomPad);
                            ctx.closePath();
                            ctx.fill();

                            ctx.fillStyle = "#f9fafb";
                            ctx.strokeStyle = "#22c55e";
                            ctx.lineWidth = 1.4;
                            points.forEach((p, idx) => {
                                const radius = idx === points.length - 1 ? 4 : 3;
                                ctx.beginPath();
                                ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
                                ctx.fill();
                                ctx.stroke();
                            });
                        })();
                    }, 220);
                });
            </script>
        </div>
