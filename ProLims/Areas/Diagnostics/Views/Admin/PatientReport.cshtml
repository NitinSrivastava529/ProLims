
@{
    ViewBag.Title = "PatientReport";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/Diagnostics/JsModule/PatientReport.js"></script>
<script src="~/JsModule/FileSaver.min.js"></script>
<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }


    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }



    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 5px !important;
    }

    .select-row {
        background-color: #d8f7b4;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Booked Test Details
                        </div>

                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <div style="display:flex">
                                    <select id="ddlclient" class="form-control"></select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div style="display:flex">
                                    <input type="date" id="txtSearchFrom" class="form-control mb-3" placeholder="from : dd-mm-yyyy" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="display:flex">
                                    <input type="date" id="txtSearchTo" class="form-control mb-3" placeholder="to : dd-mm-yyyy" />
                                    <button type="button" class="btn btn-primary mb-3" style="width:40%;margin-left:10px" id="btnSearch" onclick="Geteport(this);"><span class="fa fa-search"></span>&nbsp;Get</button>
                                    <button type="button" class="btn btn-warning mb-3" style="width:40%;margin-left:10px" id="btnExcel" onclick="DownloadExcel(this);"><span class="fa fa-file-excel-o"></span> &nbsp;Excel</button>

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div style="display:flex">
                                    <input type="text" class="form-control" id="txtSearch" placeholder="Search..." />
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:55vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblReport">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>UHID</th>
                                                <th>Ipop No</th>
                                                <th>Visit No</th>
                                                <th>Visit Date</th>
                                                <th>ItemName</th>
                                                <th style='text-align:center'>Qty</th>
                                                <th style='text-align:center'> MRP Rate</th>
                                                <th style='text-align:center'> Panel Rate</th>
                                                <th style='text-align:center'> Panel Discount</th>
                                                <th style='text-align:center'> Adl Discount</th>
                                                <th style='text-align:center'> Amount</th>
                                                <th> Sample By</th>
                                                <th> Sample Date</th>
                                                <th> DispatchNo</th>
                                                <th> Dispatch By</th>
                                                <th> Dispatch Date</th>
                                                <th style='text-align:center'> IsPushToLIS</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-8"></div>
                            <div class="col-md-4">
                                <table style="font-size: 12px;font-weight: 600;width: 100%;padding: 5px;background:#d3e5f3;margin: 1px;">

                                    <tr>
                                        <td>MRP Rate Total : </td>
                                        <td id="txtMrptotal"></td>
                                        <td>Panel Rate Total : </td>
                                        <td id="txtpanelRatetotal"></td>
                                    </tr>
                                    <tr>
                                        <td> Panel Discount Total : </td>
                                        <td id="txtpaneldistotal"></td>
                                        <td>Adl Discount Total : </td>
                                        <td id="txtAdltotal"></td>

                                    </tr>
                                    <tr>
                                        <td> Total Amount : </td>
                                        <td id="txttotal"></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
