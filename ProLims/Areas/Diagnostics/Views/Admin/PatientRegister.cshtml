
@{
    ViewBag.Title = "PatientRegister";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/Diagnostics/JsModule/PatientRegister.js"></script>
<script src="~/JsModule/FileSaver.min.js"></script>
<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }


    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }



    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 5px !important;
    }

    .select-row {
        background-color: #cde9ff;
    }

    .vtimeline .timeline-wrapper {
        display: block;
        margin-block-end: 20px;
        position: relative;
        width: 100%;
        padding-inline-end: 70px;
    }

        .vtimeline .timeline-wrapper .timeline-badge {
            width: 41px;
            height: 50px;
            position: absolute;
            inset-block-start: 5px;
            inset-inline-start: calc(50% - 20px);
            z-index: 0;
            border: 0 solid #fff;
            border-radius: 50%;
            margin-top: -5px;
        }

    .circleload {
        content: '';
        position: absolute;
        width: 30px;
        height: 30px;
        right: -17px;
        background-color: #2196F3;
        border: 4px solid #aadbf1;
        /* top: 15px; */
        border-radius: 50%;
        z-index: 1;
    }

    .vtimeline:before {
        inset-block-start: 0;
        inset-block-end: 0;
        position: absolute;
        content: " ";
        width: 3px;
        background-color: #b5deff;
        inset-inline-start: 20%;
        margin-inline-start: -1.5px;
    }

    .vtimeline .timeline-wrapper .timeline-badge {
        width: 43px;
        height: 43px;
        position: absolute;
        inset-block-start: 5px;
        inset-inline-start: calc(20% - 20px);
        z-index: 0;
        border: 0 solid #fff;
        border-radius: 50%;
        margin-top: -5px;
    }

    .vtimeline .timeline-wrapper .timeline-panel {
        border-radius: 5px;
        padding: 20px;
        position: relative;
        background: #deeffd;
        box-shadow: none;
        width: 75%;
        margin-inline-start: 15%;
    }

    .vtimeline .timeline-wrapper.timeline-inverted {
        padding-inline-end: 0;
        padding-inline-start: 90px;
    }

    .text-muted {
        color: black !important;
    }

    .badge {
        padding: 5px;
        font-size: 13px;
        /* line-height: 0; */
        /* font-weight: 200; */
        border-radius: .1875rem;
    }

    .rounded-pill {
        border-radius: var(--bs-border-radius-pill) !important;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Patient Register List
                        </div>

                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <div style="display:flex">
                                    <select id="ddlclient" class="form-control"></select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div style="display:flex">
                                    <input type="date" id="txtSearchFrom" class="form-control mb-3" placeholder="from : dd-mm-yyyy" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="display:flex">
                                    <input type="date" id="txtSearchTo" class="form-control mb-3" placeholder="to : dd-mm-yyyy" />
                                    <button type="button" class="btn btn-primary mb-3" style="width:40%;margin-left:10px" id="btnSearch" onclick="Geteport(this);"><span class="fa fa-search"></span>&nbsp;Get</button>
                                    <button type="button" class="btn btn-warning mb-3" style="width:40%;margin-left:10px" id="btnExcel" onclick="DownloadExcel(this);"><span class="fa fa-file-excel-o"></span> &nbsp;Excel</button>

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div style="display:flex">
                                    <input type="text" class="form-control" id="txtSearch" placeholder="Search..." />
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:50vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblReport">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>UHID</th>
                                                <th>IPOPType</th>
                                                <th>Visit No</th>
                                                <th>Visit Date</th>
                                                <th>Doctor Name</th>
                                                <th>Patient Name</th>
                                                <th>Age</th>
                                                <th>Gender</th>
                                                <th style='text-align:center'> Gross Amount</th>
                                                <th style='text-align:center'> Discount</th>
                                                <th style='text-align:center'> AdlDiscount</th>
                                                <th style='text-align:center'> Net Amount</th>
                                                <th style='text-align:center'> Download</th>
                                                <th style='text-align:center'> Report</th>
                                                <th style='text-align:center'> Status</th>

                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-9"></div>
                            <div class="col-md-3">
                                <table style="font-size: 12px;font-weight:600;width: 100%;padding:5px;background:#d3e5f3;margin:3px;border: 1px solid #ccc;">
                                    <tr>
                                        <td> Total Gross Amount : </td>
                                        <td id="txtMrptotal"></td>

                                    </tr>
                                    <tr>
                                        <td> Total Discount Amount : </td>
                                        <td id="txtpaneldistotal"></td>
                                    </tr>
                                    <tr>
                                        <td>Total Additional Discount Total : </td>
                                        <td id="txtAdltotal"></td>
                                    </tr>
                                    <tr>
                                        <td> Total Net Amount : </td>
                                        <td id="txttotal"></td>
                                    </tr>

                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card-body">
            <div class="modal fade" id="modelTimeline" tabindex="-1"
                 aria-labelledby="exampleModalXlLabel" style="display:none;" aria-hidden="true">
                <div class="modal-dialog modal-md">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title" id="exampleModalXlLabel">
                                TimeLine
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="vtimeline">


                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>