
@{
    ViewBag.Title = "PatientRegisterForDoctor";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<script src="~/Areas/Diagnostics/JsModule/PatientRegisterForDoctor.js?v1.1"></script>
<script src="~/JsModule/FileSaver.min.js"></script>
<style>
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }


    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }



    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .mb-3 {
        margin-bottom: 5px !important;
    }

    .select-row {
        background-color: #cde9ff;
    }

    .vtimeline .timeline-wrapper {
        display: block;
        margin-block-end: 20px;
        position: relative;
        width: 100%;
        padding-inline-end: 70px;
    }

        .vtimeline .timeline-wrapper .timeline-badge {
            width: 41px;
            height: 50px;
            position: absolute;
            inset-block-start: 5px;
            inset-inline-start: calc(50% - 20px);
            z-index: 0;
            border: 0 solid #fff;
            border-radius: 50%;
            margin-top: -5px;
        }

    .circleload {
        content: '';
        position: absolute;
        width: 30px;
        height: 30px;
        right: -17px;
        background-color: #2196F3;
        border: 4px solid #aadbf1;
        /* top: 15px; */
        border-radius: 50%;
        z-index: 1;
    }

    .vtimeline:before {
        inset-block-start: 0;
        inset-block-end: 0;
        position: absolute;
        content: " ";
        width: 3px;
        background-color: #b5deff;
        inset-inline-start: 20%;
        margin-inline-start: -1.5px;
    }

    .vtimeline .timeline-wrapper .timeline-badge {
        width: 43px;
        height: 43px;
        position: absolute;
        inset-block-start: 5px;
        inset-inline-start: calc(20% - 20px);
        z-index: 0;
        border: 0 solid #fff;
        border-radius: 50%;
        margin-top: -5px;
    }

    .vtimeline .timeline-wrapper .timeline-panel {
        border-radius: 5px;
        padding: 20px;
        position: relative;
        background: #deeffd;
        box-shadow: none;
        width: 75%;
        margin-inline-start: 15%;
    }

    .vtimeline .timeline-wrapper.timeline-inverted {
        padding-inline-end: 0;
        padding-inline-start: 90px;
    }

    .text-muted {
        color: black !important;
    }

    .badge {
        padding: 5px;
        font-size: 13px;
        /* line-height: 0; */
        /* font-weight: 200; */
        border-radius: .1875rem;
    }

    .rounded-pill {
        border-radius: var(--bs-border-radius-pill) !important;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                             Doctor Wise Patient
                        </div>

                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <div style="display:flex">
                                    <select id="ddlSearchKey" class="form-control" style="height: 35px;">
                                        <option value="ReportForDoctor:UHID">UHID</option>
                                        <option value="ReportForDoctor:MobileNo">Mobile No</option>
                                        <option value="ReportForDoctor:VisitNo">Visit No</option>
                                    </select>&nbsp;
                                    <input type="text" id="txtSearchValue" class="form-control mb-3" placeholder="Input Value" />&nbsp;
                                    <button type="button" data-logic="GetPatientRegister:BySearch" class="btn btn-primary mb-3" style="margin:0 2px" id="btnSearch" onclick="Geteport($('#ddlSearchKey option:selected').val());">Get</button>
                                </div>
                            </div>                         
                            <div class="col-md-5">
                                <div style="display:flex">
                                    <input type="date" id="txtSearchFrom" class="form-control mb-3" style="margin:0 2px" placeholder="from : dd-mm-yyyy" />
                                    <input type="date" id="txtSearchTo" class="form-control mb-3" placeholder="to : dd-mm-yyyy" />
                                    <button type="button" data-logic="GetPatientRegByDoctor:ByDate" class="btn btn-primary mb-3" style="margin:0 2px" id="btnSearch" onclick="Geteport('ReportForDoctor:Date');">Get</button>
                                    <button type="button" class="btn btn-warning mb-3" id="btnExcel" data-logic="ReportForDoctor:Date" onclick="DownloadExcel(this);">Excel</button>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div style="display:flex">
                                    <input type="text" class="form-control" id="txtSearch" placeholder="Search..." />
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="height:50vh;overflow:auto;border:1px solid #ccc">
                                    <table class="table table-bordered" id="tblReport">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>UHID</th>
                                                <th>IPOPType</th>
                                                <th>Visit No</th>
                                                <th>Visit Date</th>
                                                <th>Doctor Name</th>
                                                <th>Patient Name</th>
                                                <th>Age</th>
                                                <th>Gender</th>                                                                                        
                                                <th>Test Name</th>                                                                                        
                                                <th>Report</th>                                                                                        
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>                  
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

