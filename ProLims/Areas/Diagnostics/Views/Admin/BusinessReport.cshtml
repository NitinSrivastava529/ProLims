
@{
    ViewBag.Title = "BusinessReport";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/Diagnostics/JsModule/BusinessReport.js"></script>
<script src="~/JsModule/FileSaver.min.js"></script>
<style>
    hr {
        margin-top: 3px;
        border: 1px solid #ccc;
        margin-bottom: -10px;
        width: 100%;
    }

    input-group {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        width: 100%;
    }

    .mb-3 {
        margin-bottom: 10px !important;
    }

    .table td, .table th {
        padding: 5px;
        vertical-align: middle;
        line-height: 1.462;
        font-size: .875rem;
    }

    .table thead td, .table thead th {
        font-weight: 600;
        font-size: 12px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom-width: 1px;
        border-top-width: 0;
        padding: 5px;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .select-row {
        background-color: #e0ffe0 !important;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="mb-3 main-content-label">Business Enquiry Report</div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <label style="margin-left:40%">Status</label>
                                <div style="display:flex">
                                    <button class="btn btn-primary" id="btnPending" onclick="GetReport('GetPendingHeadList')" type="button" style="width:50%">Pending</button>
                                    <select id="ddlStatus" class="form-control" style="margin-left:10px;">
                                        <option value="ALL">ALL</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Interested">Interested </option>
                                        <option value="NotInterested ">Not Interested </option>
                                        <option value="CallYouLater ">Call You Later </option>
                                    </select>
                                </div>

                            </div>
                            <div class="col-md-3">
                                <label>From </label>
                                <input id="txtfrom" class="form-control" type="date" />
                            </div>
                            <div class="col-md-5">
                                <label>To</label>
                                <div style="display:flex">
                                    <input id="txtto" class="form-control" type="date" />
                                    <button class="btn btn-primary" id="btnSearch" onclick="GetReport('GetBusinessHeadReport')" type="button" style="margin-left:10px;width:50%">Search</button>
                                    <button class="btn btn-warning" id="btnExcel" onclick="DownloadExcel(this)" type="button" style="margin-left:10px;width:50%">Excel</button>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table table-responsive" style="margin-top:5px;border:1px solid #ccc;height:60vh;overflow:auto">
                                    <table id="tblReport" class="table table-bordered">
                                        <thead class="tofixed">

                                            <tr>

                                                <th>Employee Name</th>
                                                <th>MobileNo</th>
                                                <th>Designation</th>
                                                <th>Email</th>
                                                <th>State Name</th>
                                                <th>CityName</th>
                                                <th>Status</th>
                                                <th>HeadUserBy</th>
                                                <th>Remark</th>
                                                <th style='width: 10%;text-align:center'>Cmd</th>

                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card-body">
            <div class="modal fade" id="ModelApprove" tabindex="-1"
                 aria-labelledby="exampleModalXlLabel" style="display:none;" aria-hidden="true">
                <div class="modal-dialog modal-md">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title" id="exampleModalXlLabel">
                                Business  Enquiry Proccess
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <label>Status</label>
                                    <select id="ddlStatustype" class="form-control mb-3">
                                        <option value="0">Select</option>
                                        <option value="Interested">Interested </option>
                                        <option value="NotInterested ">Not Interested </option>
                                        <option value="CallYouLater ">Call You Later </option>
                                    </select>

                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <label>Remark</label>
                                    <div style="display:flex">
                                        <textarea type="text" placeholder="Enter Description.." id="txtRemark" class="form-control mb-3"></textarea>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <button id="btnSave" class="btn btn-success mb-3" style="float:right" onclick="Submitdata()">Submit</button>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


