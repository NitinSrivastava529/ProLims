
@{
    ViewBag.Title = "PurchaseEntry";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/PurchaseStore/JsModule/PurchaseEntry.js?anjali"></script>
<script src="~/Areas/PurchaseStore/JsModule/ItemLinkToPackManufacturer.js?anjali"></script>
<style>
    .card.custom-card .card-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        padding-block-end: 0;
        padding-block-start: 6px;
        background-color: transparent !important;
    }
    table td, table th {
        padding: 2px !important;
        font-size: 12px !important;
    }

    .form-label {
        margin-bottom: 1px;
        color: var(--default-text-color);
    }

    /*.table thead th {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
        background: -webkit-radial-gradient(cover, #00b0f5, #1b71ef) !important;
        color: white;
    }*/

    table thead input[type=text] {
        height: 21px !important;
        font-size: 12px !important;
        width: 90%;
    }

    table tbody button, table tbody category {
        padding: 1px 6px !important;
        font-size: 12px !important;
        margin-right: 5px;
    }

    .hide {
        display: none;
    }

    .toggle {
        margin-bottom: 0 !IMPORTANT;
        margin: 0;
    }

    .btn-primary {
        border: none;
        background: -webkit-radial-gradient(cover, #00b0f5, #1b71ef) !important;
        display: flex;
        align-items: center;
    }

    .btn-success {
        border: none;
        background: -webkit-radial-gradient(cover, #7bb736, #1fb724) !important;
        display: flex;
        align-items: center;
    }

    .form-control, button#btnMainMenu, button#btnSubMenu {
        line-height: 1 !important;
        font-size: 13px !important;
        height: 30px;
    }

    .form-group {
        margin-bottom: 5px;
    }


    .flex {
        display: flex;
    }

    .border-imp {
        border-bottom: 1px solid red !important;
    }

    .form-control:focus {
        border-color: #3c8dbc;
        box-shadow: none;
    }

    b {
        font-size: 12px;
    }

    #tblPaymentDetails tbody tr td {
        font-size: 12px;
        font-weight: 800;
    }

    .scroll {
        height: 50vh;
        overflow: auto;
        border: 1px solid #ccc;
        margin-bottom: 5px;
    }

    .selected {
        background: DodgerBlue !important;
        color: #fff;
    }

    #ItemList {
        border: 1px solid #c2bebe;
        /*width: 373px;*/
        width:315px;
        max-width: 500px;
        max-height: 310px;
        overflow: hidden;
        overflow-y: auto;
        position: absolute;
        z-index: 1;
        background: #fff;
        top: auto;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin-left: 0px;
        border-radius: 3px;
    }

        #ItemList table {
            font-size: 12px;
            line-height: 21px;
            width: 100%;
        }

            /*#ItemList table td {
                padding: 1px 0px 0px 10px;
            }*/

            #ItemList table tbody tr {
                max-width: 100%;
                /* padding: 1px 9px; */
                user-select: none;
                -webkit-user-select: none;
                text-overflow: ellipsis;
                white-space: nowrap;
                overflow: hidden;
                /* border-bottom: 0.1px solid #eaeaea; */
            }

    [data-search] {
        position: relative;
    }

    .link {
        color: green;
        cursor: pointer;
        font-size: 17px;
        margin: -4px 0px 0px 6px;
        z-index: 1000;
        position: absolute;
    }

    .discount {
        color: green;
        cursor: pointer;
        font-size: 17px;
        margin: 0px 0px 0px 60px;
        z-index: 1000;
        position: absolute;
    }

    .modal-title {
        line-height: 1.42857143;
        margin: 0;
        font-family: none;
    }

    .text-white {
        margin: 4px;
        color: #fff;
    }

    #tblProductInfo tbody td, #BasicInfo tbody td {
        padding: 2px 2px 0px 0px;
    }

    table tbody td input, select {
        border: 1px solid #9c9c9c !important;
    }

    .paymode {
        border: 1px solid #9c9c9c !important;
        height: 30px;
        padding: 5px;
        width: 40%;
    }

    .w60 {
        width: 60px !important;
    }

    #tblnavigate tbody td {
        padding-left: 6px !important;
    }

    .card-body {
        /*padding: 10px 0px 5px 15px;*/
        padding: 10px 10px 10px 10px;
    }

    .table {
        font-size: 11px;
        width: 100%;
        border-spacing: 0;
        /*border-collapse: separate;*/
    }

    fieldset {
        border: 1px solid #ccc;
        padding: 10px;
    }

    legend {
        color: #333;
        font-size: 16px;
        font-weight: bold;
        padding: 2px 10px;
      border: 1px solid #ccc;
  border-radius: 5px;
     background-color: #f2f2f2;
    }
    .select2-hidden-accessible {
        border: 0 !important;
        clip: rect(0 0 0 0) !important;
        height: 1px !important;
        margin: -1px !important;
        overflow: hidden !important;
        padding: 0 !important;
        position: absolute !important;
        width: 1px !important;
    }
    #tbltaxdetails tbody tr td {
        font-size: 12px;
        font-weight: 800;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Purchase Entry
                        </div>
                        <div class="col-md-10">
                            <button type="button" data-bs-toggle="modal" class=" btn btn-primary" style="float:right;margin-bottom:5px;" data-bs-target="#modalUnCompPurchases" onclick="GetRecord()">
                                UnCompleted Purchases
                            </button>
                        </div>
                    </div>
                    <hr style="margin:0px;" />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                <table class="table" id="BasicInfo" style="margin-bottom:5px">
                                    <tbody>
                                        <tr>
                                            <td><b>Supplier</b></td>
                                            <td><b>:</b></td>
                                            <td style="width:240px !important">
                                                <select class="form-control border-imp" id="ddlSupplier" data-imp></select>
                                            </td>
                                            <td><b>Grn Type</b></td>
                                            <td><b>:</b></td>
                                            <td style="width:20%">
                                                <select class="form-control" id="ddlGrnType">
                                                    @*<option>Select GRN</option>*@
                                                    <option>Invoice</option>
                                                    <option>Challan</option>
                                                </select>
                                            </td>
                                            <td class="invoice"><b><span class="iname">Invoice No.</span> & Date</b></td>
                                            <td class="invoice"><b>:</b></td>
                                            <td class="invoice">
                                                <div style="display:flex">
                                                    <input type="text" class="form-control  border-imp" data-imp id="txtInvoiceNo" placeholder="Invoice No." style="width:40%" />
                                                    <input type="date" class="form-control  border-imp" id="txtInvoiceDate" placeholder="Date" data-imp style="width:60%" />
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>

                                            <td><b>Nature Of Purchase</b></td>
                                            <td><b>:</b></td>
                                            <td>
                                                <select id="ddlNatureOfPurchase" class="form-control">
                                                    <option>Consumable</option>
                                                    <option>Assets</option>

                                                </select>
                                            </td>
                                            <td> <b>eWay Bill No. & Date</b></td>
                                            <td><b>:</b></td>
                                            <td>
                                                <div style="display:flex">
                                                    <input type="text" class="form-control" id="txtEwayBillNo" placeholder="eWay Bill No." style="width:60%" />
                                                    <input type="date" class="form-control" id="txtEwayBillDate" placeholder="Date" style="width:60%" />
                                                </div>
                                            </td>
                                            <td><b>GRN Pay Mode</b></td>
                                            <td><b>:</b></td>
                                            <td style="display:flex">
                                                <span class="paymode">
                                                    <label><input type="radio" name="PayMode" value="Credit" /> &nbsp;Credit</label> &nbsp; &nbsp;
                                                    <label><input type="radio" name="PayMode" value="Cash" />  &nbsp;Cash</label>&nbsp; &nbsp;
                                                </span>
                                                <input type="text" id="txtPurchaseId" class="form-control" value="Auto Generate" disabled="" style="width:60%;background:#fff;opacity:100%" placeholder="Purchase Id" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <table class="table" id="tblProductInfo" style="margin-bottom:5px">
                                    <tbody>
                                        <tr style="background:#cce9ff">
                                            <td style="width:15%;">
                                                <label>Product Name</label>
                                                <div data-search>
                                                    <input type="text" id="txtSearchProduct" data-imp class="form-control border-imp" autocomplete="off" placeholder="Search Product..." />
                                                    <div id="ItemList" style="display:none">
                                                        <table id="tblnavigate">
                                                            <tbody></tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </td>
                                            <td style="width:10%;">
                                                <label>
                                                    Manufacturer
                                                    <span style="float: right;margin-left:10px;color: green;" data-bs-toggle="modal"
                                                          data-bs-target="#ModalItemPackLink" onclick="GetRecord()">
                                                        <i class="fa fa-plus-square"></i>
                                                    </span>
                                                </label>
                                                <select class="form-control" id="ddlManufacture">
                                                    <option>Manufacturer</option>
                                                </select>
                                            </td>
                                            <td style="width:6%">
                                                <label>HSN</label>
                                                <input type="text" readonly="readonly" id="txtHsn" class="form-control" placeholder="HSN">
                                            </td>
                                            <td style="width:6%">
                                                <label>Batch</label>
                                                <input type="text" id="txtBatch" data-imp class="form-control border-imp" placeholder="Batch">
                                            </td>
                                            <td style="width:6%">
                                                <label>Exp. Date</label>
                                                <input type="text" maxlength="7" onkeyup="if (/[^\d-]/g.test(this.value)) this.value = this.value.replace(/[^\d-]/g, '')" id="txtExpDate" class="form-control" placeholder="mm-yy">
                                            </td>
                                            <td style="width:7%">
                                                <label>P.Type</label>
                                                <select id="ddlPackType" class="form-control border-imp" data-imp style="width:90px;">
                                                    <option>Pack Type</option>
                                                </select>
                                            </td>
                                            <td style="width:6%">
                                                <label>MRP</label>
                                                <input type="text" id="txtMRP" data-imp maxlength="12" onkeyup="CalAmount1();if (/[^\d.]/g.test(this.value)) this.value = this.value.replace(/[^\d.]/g, '');" class="form-control border-imp" placeholder="MRP">
                                            </td>
                                            <td style="width:6%">
                                                <label>Pur-Rate</label>
                                                <input type="text" id="txtTrade" data-imp maxlength="12" onkeyup="CalAmount();if (/[^\d.]/g.test(this.value)) this.value = this.value.replace(/[^\d.]/g, '');" class="form-control border-imp" placeholder="Pur-Rate">
                                            </td>

                                            <td style="width:6%">
                                                <label>Qty <span style="margin-left: 37px;">Stk. Qty.</span></label>
                                                <div style="display:flex">
                                                    <input type="text" id="txtQty" data-imp maxlength="7" onkeyup="CalAmount();if (/[^\d.]/g.test(this.value)) this.value = this.value.replace(/[^\d.]/g, '');" class="form-control w60 border-imp" placeholder="Qty">
                                                    <input type="text" id="txtSQty" data-imp maxlength="7" disabled onkeyup="CalAmount();if (/[^\d.]/g.test(this.value)) this.value = this.value.replace(/[^\d.]/g, '');" class="form-control w60 border-imp" placeholder="0">
                                                </div>
                                            </td>
                                            <td style="width:6%">
                                                <label>Free</label>
                                                <input type="text" id="txtFree" value="0" maxlength="12" data-int class="form-control" placeholder="Free">
                                            </td>
                                            <td style="width:8%">
                                                <label>GST</label>
                                                <select id="ddlGst" data-imp class="form-control"></select>
                                            </td>
                                            <td style="width:6%">
                                                <label>Disc%</label>
                                                <input type="text" id="txtDisc" value="0" maxlength="3" onkeyup=" if (/[^\d.]/g.test(this.value)) this.value = this.value.replace(/[^\d.]/g, '');" class="form-control" placeholder="Disc%">
                                            </td>
                                            <td style="width:6%">
                                                <label>Amount</label>
                                                <input type="text" id="txtAmount" maxlength="12" readonly onkeyup=" if (/[^\d.]/g.test(this.value)) this.value = this.value.replace(/[^\d.]/g, '');" class="form-control" placeholder="Amount">
                                            </td>
                                            <td>
                                                <label style="visibility:hidden ">Amount</label>
                                                <submit onclick="InsertPurchase()" class="btn btn-success"> &nbsp;<i class="fa fa-plus"></i></submit>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <hr style="margin:0px;" />
                        <div class="row">
                            <div class="col-md-12">
                                <div class="scroll" style="height:30vh;overflow:auto">
                                    <table class="table table-bordered" id="tblPurchaseEntry">
                                        <thead  style="background: #2d82ff;color: white;">
                                            <tr>
                                                <th style="width:218px;">
                                                    Product Name
                                                </th>
                                                <th>
                                                    Mfd. Name
                                                </th>
                                                <th>
                                                    HSN
                                                </th>
                                                <th>
                                                    Batch No
                                                </th>
                                                <th>
                                                    Exp. Date
                                                </th>
                                                <th>
                                                    Pack Type
                                                </th>
                                                <th>
                                                    MRP
                                                </th>
                                                <th>
                                                    Pur-Rate
                                                </th>
                                                <th>
                                                    NPR
                                                </th>
                                                <th>
                                                    Qty
                                                </th>
                                                <th>
                                                    Free
                                                </th>
                                                <th>
                                                    Tax Rate
                                                </th>
                                                <th>
                                                    Tax Amount
                                                </th>
                                                <th>
                                                    Amount
                                                </th>

                                                <th>
                                                    Dis Per.
                                                </th>
                                                <th>
                                                    Dis. Amount
                                                </th>
                                                <th>
                                                    Action
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <form>
                            <fieldset>
                                <div class="row">
                                    <div class="col-md-6">


                                        <div class="row">
                                            <div class="col-md-12">
                                                <table class="table table" id="tbltaxdetails" style="background:#f1f1f1;">
                                                    @*<tr style="border-bottom: 1px solid black;">
                                                        <td>GRN No: &nbsp;&nbsp;<span id="txtGrnNo" style="font-size:13px;color:blue"></span></td>
                                                        <td>Item Id :&nbsp;&nbsp;<span id="txtItemid" style="font-size:13px;color:blue"></span></td>
                                                        <td colspan="4">Item Name : &nbsp;&nbsp;<span id="txtItemName" style="font-size:13px;color:blue"></span></td>

                                                    </tr>*@
                                                    <tr>
                                                        <td style="width:20%">
                                                            <label>Other Charges</label>
                                                            <select id="ddlcharges" class="form-control" style="background:#fff;opacity:100%"></select>
                                                        </td>
                                                        <td>
                                                            <label>Taxable Amount</label>
                                                            <input type="text" id="txtTaxableAmt" style="background:#fff;opacity:100%" class="form-control" placeholder="0">
                                                        </td>
                                                        <td>
                                                            <label>Taxable Rate</label>
                                                            <input type="text" id="txtTaxableRate" style="background:#fff;opacity:100%" class="form-control" placeholder="0">
                                                        </td>
                                                        <td>
                                                            <label>Tax</label>
                                                            <input type="text" id="txtTaxvalue" style="background:#fff;opacity:100%" class="form-control" placeholder="0">
                                                        </td>
                                                        <td>
                                                            <label>.</label>
                                                            <button class="btn btn-primary" id="btnADD" style="height: 30px;" type="button" onclick="insertTax()">ADD</button>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="scroll" style="height:11vh;overflow:auto">
                                                    <table class="table table-bordered" id="tblTaxEntry">
                                                        <thead style="background: #2d82ff;color: white;">
                                                            <tr>
                                                                <th>Other Charges</th>
                                                                <th style='text-align:center'> Taxable Amount  </th>
                                                                <th style='text-align:center'> Taxable Rate </th>
                                                                <th style='text-align:center'>Tax</th>
                                                                <th style='text-align:center'>  Cmd </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody></tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-md-6">
                                        <table class="table table" id="tblPaymentDetails" style="background:#f1f1f1">
                                            <tr>
                                                <td colspan="5" style="border-bottom: 1px solid black;">
                                                    <label style="font-size: 16px;">Payment Details</label>
                                                    <span class="discount" data-bs-toggle="modal"
                                                          data-bs-target="#modalDiscount" onclick="GetRecord()">
                                                        <i class="fa fa-plus-square"></i>
                                                    </span>

                                                </td>
                                            </tr>


                                            <tr>
                                                <td>
                                                    <label>Taxable Amount</label>
                                                    <input type="text" id="txtTotal" readonly="readonly" style="background:#fff;opacity:100%" class="form-control" placeholder="Total">
                                                </td>

                                                <td>
                                                    <label>IGST</label>
                                                    <input type="text" id="txtIGST" readonly="readonly" style="background:#fff;opacity:100%" class="form-control" placeholder="IGST">
                                                </td>
                                                <td>
                                                    <label>CGST</label>
                                                    <input type="text" id="txtCGST" readonly="readonly" style="background:#fff;opacity:100%" class="form-control" placeholder="CGST">
                                                </td>
                                                <td>
                                                    <label>SGST</label>
                                                    <input type="text" id="txtSGST" readonly="readonly" style="background:#fff;opacity:100%" class="form-control" placeholder="SGST" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <label>Discount </label>
                                                    <input type="text" id="txtDiscount" readonly="readonly" style="background:#fff;opacity:100%" class="form-control" placeholder="Discount">
                                                </td>
                                                <td>
                                                    <label>Net Amt</label>
                                                    <input type="text" id="txtNetAmount" readonly="readonly" style="background:#fff;opacity:100%" class="form-control" placeholder="Net Amt">
                                                </td>
                                                <td>
                                                    <label>Bill Amount</label>
                                                    <input type="text" id="txtRoundOff" readonly="readonly" style="background:#fff;opacity:100%" class="form-control" placeholder="Round Off">
                                                </td>
                                            </tr>
                                        </table>
                                    </div>

                                </div>
                            </fieldset>
                        </form>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card-body">
            <div class="modal fade" id="ModalItemPackLink" tabindex="-1"
                 aria-labelledby="exampleModalXlLabel" style="display:none;" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content" style="margin-left:10%">
                        <div class="modal-header">
                            <h6 class="modal-title" id="exampleModalXlLabel" style="font-size: 25px;">
                                <span data-itemname></span>-<span data-itemid></span>
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <input type="text" class="form-control" id="txtSearchItemLink" placeholder="Search..." />
                                    <div class="table-responsive scroll">
                                        <table class="table table-bordered" id="tblItem">
                                            <thead style="background: #2d82ff;color: white;">
                                                <tr>
                                                    <th>Item Id</th>
                                                    <th>Item Name</th>
                                                    <th style="width:1%">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="row">
                                        <div class="col-md-7">
                                            <select class="form-control" id="ddlLinkPack"></select>
                                        </div>
                                        <div class="col-md-5">
                                            <div class="flex">
                                                <input id="txtpackqty" class="form-control" type="text" style="height:30px" disabled placeholder="pack Qty" />
                                                <span id="btnLinkPack" class="input-group-addon btn btn-primary">
                                                    <i class="fa fa-plus"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                              
                                   <div class="row">
                                       <div class="col-md-12">
                                           <div class="table-responsive scroll">
                                               <table class="table table-bordered" id="tblLinkPack">
                                                   <thead style="background: #2d82ff;color: white;">
                                                       <tr>
                                                           <th>Pack Name</th>
                                                           <th style="width:25%; text-align:center;">Pack Qty</th>
                                                           <th style="width:1%">Delete</th>
                                                           
                                                       </tr>
                                                   </thead>
                                                   <tbody></tbody>
                                               </table>
                                           </div>
                                       </div>
                                   </div>
                                </div>
                                <div class="col-md-4">
                                    <div style="display:flex">
                                        <select class="form-control" id="ddlLinkManufacturer"></select>
                                        <span id="btnLinkManufacturer" class="btn btn-success" style="margin-left:10px">
                                            <i class="fa fa-plus"></i>
                                        </span>
                                    </div>
                                    <div class="table-responsive scroll">
                                        <table class="table table-bordered" id="tblLinkManufacturer">
                                            <thead style="background: #2d82ff;color: white;">
                                                <tr>
                                                    <th>Manufacturer</th>
                                                    <th style="width:1%">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card-body">
            <div class="modal fade" id="modalDiscount" tabindex="-1"
                 aria-labelledby="exampleModalXlLabel" style="display:none;" aria-hidden="true">
                <div class="modal-dialog modal-md">
                    <div class="modal-content" style="margin-left:10%;margin-top:180px;">
                        <div class="modal-header">
                            <h6 class="modal-title" id="exampleModalXlLabel">
                                Purchase  Discount
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
