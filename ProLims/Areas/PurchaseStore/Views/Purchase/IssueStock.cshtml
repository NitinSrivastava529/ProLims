
@{
    ViewBag.Title = "IssueStock";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/PurchaseStore/JsModule/IssueStock.js"></script>
<style>
    hr {
        margin-top: 2px;
        border: 1px solid #726f6f;
        margin-bottom: 4px;
    }

    .mb-3 {
        margin-bottom: 10px !important;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .select-row {
        background: #bfbfbf;
    }

    .table thead td, .table thead th {
        font-weight: 500;
        font-size: 12px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom-width: 1px;
        border-top-width: 0;
        padding: 5px;
    }

    .table td, .table th {
        padding: 5px;
        vertical-align: middle;
        line-height: 1.462;
        font-size: 12px;
    }
</style>
<style>
    .ui-state-hover, .ui-widget-content .ui-state-hover, .ui-widget-header .ui-state-hover, .ui-state-focus, .ui-widget-content .ui-state-focus, .ui-widget-header .ui-state-focus {
        /*border: 1px solid #cdd5da;*/
        background: DodgerBlue !important;
        color: #fff !important;
        max-width: 260px;
    }

    .ui-autocomplete {
        padding: 0;
        max-width: 260px;
        max-height: 320px;
        overflow: scroll;
        overflow-x: hidden;
    }

    .ui-menu-item {
    }

    .ui-menu .ui-menu-item a {
        font-family: inherit;
        padding: 5px 12px;
        font-size: 10px;
        color: #2b2f33;
        font-family: Arial;
    }

    .selected {
        background: DodgerBlue !important;
        color: #fff;
    }

    .autocomplete {
        /*the container must be positioned relative:*/
        position: relative;
        display: inline-block;
    }

    #ItemList {
        box-shadow: 1px 1px 1px #ececec;
        border: 0px solid #ececec;
        width: 300px;
        max-width: 300px;
        max-height: 361px;
        /*overflow: scroll;*/
        overflow-x: hidden;
        position: absolute;
        z-index: 1;
        background: #fff;
    }

    #ItemListDetails {
        box-shadow: 1px 1px 1px #ececec;
        border: 1px solid #ececec;
        width: 500px;
        max-width: 500px;
        max-height: 361px;
        overflow: auto;
        overflow-x: auto;
        position: absolute;
        z-index: 1;
        background: #fff;
        left: 253px;
        margin-top: -5px;
    }

        #ItemListDetails thead {
            border-bottom: 1px dashed#e8e8e8;
        }

    .bg-blue {
        background: #007ffb;
        color: #fff;
        border: none;
    }

    #ItemList table {
        font-size: 11px;
        line-height: 22px;
        width: 100%;
    }

    #ItemListDetails table {
        font-size: 11px;
        line-height: 22px;
        width: 100%;
    }

    .btnfa {
        text-align: center;
        cursor: pointer;
        font-size: 16px !important;
        padding: 1px !important;
    }

    #ItemList table td, #ItemListDetails table td, #ItemListDetails table th {
        padding: 1px 0px 0px 10px;
    }

    #ItemList table tbody tr, #ItemListDetails table tbody tr {
        border-bottom: 0.1px solid #eaeaea;
    }

    #tblUnCompleteOrder {
        width: 100%;
        background: #fff;
        overflow: overlay;
        height: 337px;
        display: block;
    }

    .focus {
        border-color: red;
    }

    #tblUnCompleteOrder tbody tr td {
        border-bottom: 1px solid #f1f1f1 !important;
    }

        #tblUnCompleteOrder tbody tr td:nth-child(1) {
            width: 5% !important;
        }

    #tblUnCompleteOrder th:nth-child(1) {
        width: 1% !important;
    }

    .form-control[disabled], .form-control[readonly], fieldset[disabled] .form-control, input[disabled], select[disabled], textarea[disabled] {
        cursor: not-allowed;
        opacity: .65;
        background: #deeffd;
        filter: alpha(opacity: 65);
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Issue Stock
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div id="loader" style="display:none">
                            @*@Html.Partial("Spiner")*@
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <span class="text-pink">Issue Stock</span><br />
                                <span class="text-primary">Note : Be Sure to Complete Issue for Displaying in Warehouse. </span>
                            </div>
                            <div class="col-md-6">
                                <label>Choose Employee</label>
                                <div class="d-flex align-items-start mb-3">
                                    <select id="ddlEmployee" class="form-control"></select>
                                </div>
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-md-4">
                                <div class="d-flex align-items-start">
                                    <div class="autocomplete" style="width:300px;">
                                        <label>Product Name <input type="checkbox" name="returnProduct">Return Product</label>
                                        <input type="text" id="txtIssueItemName" class="form-control input_pass" value="" placeholder="Product Name">
                                    </div>

                                </div>
                                <div id="ItemList" style="display:none">
                                    <table id="tblIssuenavigate">
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label>In Stock</label>
                                <div class="d-flex align-items-start">
                                    <input type="text" id="txtIssueInStock" readonly="readonly" class="form-control input_pass" placeholder="In Stock">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label>Pack Type</label>
                                <div class="d-flex align-items-start">
                                    <input type="text" id="txtIssuePackType" readonly="readonly" class="form-control input_pass" value="" placeholder="Pack Type">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label>Pack Quantity</label>
                                <div class="d-flex align-items-start">
                                    <input type="text" id="txtIssuePQuantity" readonly="readonly" class="form-control input_pass" value="" placeholder="P.Quantity">
                                </div>
                            </div>

                            <div class="col-md-2">
                                <label>Quantity</label>
                                <div class="d-flex align-items-start">
                                    <input type="text" id="txtIssueQuantity" class="form-control input_pass mb-3" placeholder="Quantity..">
                                    <span id="btnSaveIssueOrder" class="input-group-addon btn btn-primary">
                                        <i class="fa fa-plus"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div id="ItemListDetails" style="display:none;">
                                <table id="tblIssueItemList" class="">
                                    <thead>
                                        <tr>
                                            <th>Master-Key-ID</th>
                                            <th>Pack Type</th>
                                            <th>Batch No</th>
                                            <th>Pack Qty</th>
                                            <th>Expiry Date</th>
                                            <th>Quantity</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="table table-responsive" style="height:60vh;overflow:auto; border:1px solid #ccc">
                                    <table id="tblIssueUnCompleteOrder" class="table table-bordered ">
                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                            <tr>
                                                <th>Action</th>
                                                <th>Master Key Id</th>
                                                <th>Item Name</th>
                                                <th>Pack type</th>
                                                <th>Pack Quantity</th>
                                                <th>Issued Quantity</th>
                                                <th>Batch No</th>
                                                <th>Expiry Date</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                        </div>


                    </div>
                </div>
            </div>

        </div>
    </div>
</div>