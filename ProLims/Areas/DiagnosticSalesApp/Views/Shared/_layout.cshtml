
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="~/Areas/DiagnosticSalesApp/Assets/vender/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Areas/DiagnosticSalesApp/Assets/css/style.css" rel="stylesheet" />
    <script src="~/Areas/DiagnosticSalesApp/Assets/js/jquery.min.js"></script>
    <script src="~/JsModule/global.js"></script>
    <script src="~/Areas/DiagnosticSalesApp/Assets/js/script.js"></script>
    <style>
        .header-logo {
            width: 30px;
            margin-right: 5px;
        }
    </style>
    <script>
        function logOut() {
            localStorage.clear();
            window.location.href = "/";
        }
    </script>
</head>
<body>

    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="d-flex align-items-center mb-3">
                <div class="user-avatar me-3">
                    <i class="bi bi-person"></i>
                </div>
                <div>
                    <h6 class="mb-1">Nitin Kumar Srivastava</h6>
                    <p class="mb-0 small">Emp Code : CPL-00233</p>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small>Sales App</small>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-star-fill me-1 points-icon"></i>
                        <span>******</span>
                    </div>
                </div>
                <a href="profile.html" class="btn btn-sm profile-edit-btn rounded-3">
                    Edit Profile
                </a>
            </div>
        </div>
        <div class="sidebar-menu">
            <a routerLink="dashboard" href="" class="sidebar-menu-item">
                <i class="bi bi-house-door"></i>
                <span>Dashboard</span>
            </a>
            <a routerLink="mark-attendance" class="sidebar-menu-item">
                <i class="bi bi-view-list"></i>
                <span>Franchise Only</span>
            </a>
            <a routerLink="mark-attendance" class="sidebar-menu-item">
                <i class="bi bi-view-list"></i>
                <span>NHM Diagnostic Sales</span>
            </a>
            <a routerLink="mark-attendance" class="sidebar-menu-item">
                <i class="bi bi-clock-history"></i>
                <span>Mark Attendance</span>
            </a>
            <a routerLink="change-password" class="sidebar-menu-item">
                <i class="bi bi-key"></i>
                <span>Change Password</span>
            </a>
        </div>
        <div class="p-3 text-center">
            <a onclick="logOut()" class="btn btn-outline-danger w-100 rounded-3">
                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
            </a>
        </div>
    </div>
    <!-- Overlay -->
    <div class="overlay" id="overlay"></div>
    <!-- App Header -->
    <div class="app-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button id="menuBtn" class="btn menu-btn">
                <i class="bi bi-list menu-icon"></i>
            </button>
            <div class="d-flex align-items-center">
                @*<img class="header-logo" src="~/assets/images/logo_trans.png" />*@
                <span class="app-header-title">Diagnostic Sales App</span>
            </div>
        </div>
        <div>
            <a href="notifications.html" class="btn header-btn me-2">
                <i class="bi bi-bell icon-md"></i>
            </a>
            <a href="settings.html" class="btn header-btn">
                <i class="bi bi-person-circle icon-md"></i>
            </a>
        </div>
    </div>
    <!-- Main Content Area -->
    @RenderBody()

    <!-- Bottom Navigation Bar (App-style) -->
    <div class="bottom-nav">
        <a href="dashboard" class="nav-item active">
            <i class="bi bi-house-door-fill"></i>
            <span>Dashboard</span>
        </a>
        <a routerLink="mark-attendance" class="nav-item">
            <i class="bi bi-clock-history"></i>
            <span>Geo Tagging</span>
        </a>
        <a routerLink="view-attendance" class="nav-item">
            <i class="bi bi-eye"></i>
            <span>Visit Info</span>
        </a>
        <a routerLink="attendance-correction" class="nav-item">
            <i class="bi bi-file-earmark-text"></i>
            <span>Correction</span>
        </a>
        <a routerLink="profile" class="nav-item">
            <i class="bi bi-person"></i>
            <span>Profile</span>
        </a>
    </div>
</body>
</html>