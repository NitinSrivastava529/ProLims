<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
                        const statusEl = document.getElementById('status');
                        const markBtn = document.getElementById('markBtn');
                        const checkBtn = document.getElementById('checkBtn');
                        const clearBtn = document.getElementById('clearBtn');
                        const officeLatInput = document.getElementById('officeLat');
                        const officeLonInput = document.getElementById('officeLon');
                        const radiusInput = document.getElementById('radiusMeters');
                        const updateBtn = document.getElementById('updateConfig');
                        const recordsTable = document.querySelector('#recordsTable tbody');
                        const STORAGE_KEY = 'geo_attendance_records';

                        // ---- Map setup ----
                        let map = L.map('map').setView([28.613939, 77.209021], 16);
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            maxZoom: 19,
                            attribution: '&copy; OpenStreetMap'
                        }).addTo(map);

                        let officeCircle, officeMarker, userMarker;

                        // helpers
                        function showStatus(msg, ok = true) {
                            statusEl.textContent = msg;
                            statusEl.className = 'status ' + (ok ? 'ok' : 'err');
                        }

                        function toRad(x) { return x * Math.PI / 180; }
                        function haversine(lat1, lon1, lat2, lon2) {
                            const R = 6371000;
                            const dLat = toRad(lat2 - lat1);
                            const dLon = toRad(lon2 - lon1);
                            const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
                            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                        }

                        function getConfig() {
                            return {
                                lat: parseFloat(officeLatInput.value),
                                lon: parseFloat(officeLonInput.value),
                                radius: parseFloat(radiusInput.value)
                            };
                        }

                        function updateMap() {
                            const cfg = getConfig();
                            if (officeCircle) { map.removeLayer(officeCircle); }
                            if (officeMarker) { map.removeLayer(officeMarker); }

                            officeMarker = L.marker([cfg.lat, cfg.lon]).addTo(map).bindPopup("Office");
                            officeCircle = L.circle([cfg.lat, cfg.lon], { radius: cfg.radius, color: "#0ea5e9", fillColor: "#93c5fd", fillOpacity: 0.3 }).addTo(map);
                            map.setView([cfg.lat, cfg.lon], 17);
                        }

                        function saveRecord(r) {
                            const arr = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
                            arr.unshift(r);
                            localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
                            renderRecords();
                        }

                        function renderRecords() {
                            const arr = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
                            recordsTable.innerHTML = '';
                            arr.forEach((r, i) => {
                                const tr = document.createElement('tr');
                                tr.innerHTML = `<td>${i + 1}</td>
                                        <td>${new Date(r.ts).toLocaleString()}</td>
                                        <td>${r.lat.toFixed(5)}</td>
                                        <td>${r.lon.toFixed(5)}</td>
                                        <td>${r.dist.toFixed(1)}</td>
                                        <td>${r.status}</td>`;
                                recordsTable.appendChild(tr);
                            });
                        }

                        function getLocation() {
                            return new Promise((resolve, reject) => {
                                if (!navigator.geolocation) return reject(new Error("Geolocation not supported"));
                                navigator.geolocation.getCurrentPosition(
                                    pos => resolve(pos.coords),
                                    err => reject(err),
                                    { enableHighAccuracy: true, timeout: 15000 }
                                );
                            });
                        }

                        // --- Main actions ---
                        checkBtn.onclick = async () => {
                            showStatus("Checking location...");
                            try {
                                const cfg = getConfig();
                                const coords = await getLocation();
                                const dist = haversine(coords.latitude, coords.longitude, cfg.lat, cfg.lon);

                                // update map
                                if (userMarker) map.removeLayer(userMarker);
                                userMarker = L.marker([coords.latitude, coords.longitude]).addTo(map).bindPopup("You are here").openPopup();

                                map.fitBounds(L.latLngBounds([[coords.latitude, coords.longitude], [cfg.lat, cfg.lon]]), { padding: [40, 40] });
                                const inside = dist <= cfg.radius;
                                showStatus(`You are ${(dist/1000).toFixed(1)} km from office. ${inside ? "Inside" : "Outside"} geofence.`, inside);
                            } catch (e) {
                                showStatus("Error: " + e.message, false);
                            }
                        };

                        markBtn.onclick = async () => {
                            showStatus("Marking attendance...");
                            try {
                                const cfg = getConfig();
                                const coords = await getLocation();
                                const dist = haversine(coords.latitude, coords.longitude, cfg.lat, cfg.lon);
                                const inside = dist <= cfg.radius;

                                if (userMarker) map.removeLayer(userMarker);
                                userMarker = L.marker([coords.latitude, coords.longitude]).addTo(map).bindPopup("You are here").openPopup();

                                saveRecord({
                                    ts: Date.now(),
                                    lat: coords.latitude,
                                    lon: coords.longitude,
                                    dist,
                                    status: inside ? "Marked (inside)" : "Rejected (outside)"
                                });
                                if (inside) {
                                    MarkAtt(coords.latitude, coords.longitude)
                                }
                                showStatus(inside ? "✅ Attendance marked successfully." : "❌ Outside geofence.", inside);

                            } catch (e) {
                                showStatus("Error: " + e.message, false);
                            }
                        };

                        updateBtn.onclick = () => { updateMap(); showStatus("Map updated with new geofence."); };
                        clearBtn.onclick = () => { localStorage.removeItem(STORAGE_KEY); renderRecords(); showStatus("Records cleared."); };
</script>
