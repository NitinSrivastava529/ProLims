
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/B2B/Views/Shared/_layout.cshtml";
}
<style>
    #ddlPatientList {
        margin: 10px;
        width: 94%;
    }

    body {
        background-color: #ececec;
    }

    .report {
        border-radius: 3px;
        box-shadow: 1px 0px 4px #e0e0e0;
        cursor: pointer;
        border: 1px solid #e6e6e6;
        background: #fff;
        padding: 9px 0px;
        display: flex;
        width: 94%;
        margin-bottom: 7px;
        margin: 10px;
    }

    .report-left {
        border: 1px solid #513d6f;
        margin: 0 10px;
        width: 90px;
        background: #513d6fde;
        color: #fff;
        padding: 15px 30px;
    }

        .report-left .fa {
            font-size: 25px;
            color: #fff;
        }

    .report-right {
        width: 75%;
    }

    .report-title {
        font-size: 12px;
        font-weight: 500;
        color: #000;
    }

    .report-des {
        font-size: 10px;
        color: #999999;
    }

    .report-btn {
        width: 65px;
        padding: 0px 14px;
        font-size: 13px;
        border: none;
        box-shadow: none;
    }

    .card {
        position: relative;
        display: -ms-flexbox;
        display: flex;
        -ms-flex-direction: column;
        flex-direction: column;
        min-width: 0;
        word-wrap: break-word;
        background-color: #fff;
        background-clip: border-box;
        border: 1px solid rgba(0,0,0,.125);
        border-radius: .25rem;
    }

    .visitnow {
        padding: 0px 19px 5px 19px;
        margin-top: 8px;
    }

    .card-body {
        BACKGROUND-COLOR: #d8d5d5;
        height: 106px;
        -ms-flex: 1 1 auto;
        flex: 1 1 auto;
        min-height: 1px;
        padding: 1.25rem;
    }

    .FixedUserInfo {
        position: fixed;
        bottom: 0;
        margin: 9px;
        width: 90%;
    }
</style>
<script>
    function OpenReportUrl(link) {
        window.location.href = config.rootUrl + '/B2B/Patient/' + link;
    }
</script>
<div id="page-content" style="background: #ececec;margin-bottom: 100px;">
    <div class="report" onclick="OpenReportUrl('PatientRegistration')">
        <div class="report-left">
            <i class="fa fa-edit">&nbsp;</i>
        </div>
        <div class="report-right">
            <span class="report-title">Patient Registration</span><br />
            <span class="report-des">Register New Patient.</span>
        </div>
    </div>
    <div class="report" onclick="OpenReportUrl('SampleCollection')">
        <div class="report-left">
            <i class="fa fa-registered">&nbsp;</i>
        </div>
        <div class="report-right">
            <span class="report-title">Sample Collection</span><br />
            <span class="report-des">Sample Collection.</span>
        </div>
    </div>
    <div class="report" onclick="OpenReportUrl('DispatchSample')">
        <div class="report-left">
            <i class="fa fa-sign-in">&nbsp;</i>
        </div>
        <div class="report-right">
            <span class="report-title">Dispatch Sample</span><br />
            <span class="report-des">Dispatch Sample.</span>
        </div>
    </div>
    <div class="report" id="DeltaReport" onclick="OpenReportUrl('PatientReport')">
        <div class="report-left">
            <i class="fa fa-file">&nbsp;</i>
        </div>
        <div class="report-right">
            <span class="report-title">Patient Reports</span><br />
            <span class="report-des">Patient Report Of Test.</span>
        </div>
    </div>
    <div class="report" id="DeltaReport" onclick="OpenReportUrl('SampleCancellation')">
        <div class="report-left">
            <i class="fa fa-file">&nbsp;</i>
        </div>
        <div class="report-right">
            <span class="report-title">Sample Cancellation</span><br />
            <span class="report-des">Sample Cancellation..</span>
        </div>
    </div>
    <div class="report" id="DeltaReport" onclick="OpenReportUrl('FinanceReport')">
        <div class="report-left">
            <i class="fa fa-file">&nbsp;</i>
        </div>
        <div class="report-right">
            <span class="report-title">Finance Report</span><br />
            <span class="report-des">Finance Report..</span>
        </div>
    </div>
    <div class="report" id="DeltaReport" onclick="OpenReportUrl('MarkAttendance')">
        <div class="report-left">
            <i class="fa fa-file">&nbsp;</i>
        </div>
        <div class="report-right">
            <span class="report-title">Mark Attendance</span><br />
            <span class="report-des">Employee Can Mark Attendance..</span>
        </div>
    </div>
</div>

