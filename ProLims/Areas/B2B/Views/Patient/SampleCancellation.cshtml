
@{
    ViewBag.Title = "SampleCancellation";
    Layout = "~/Areas/B2B/Views/Shared/_layout.cshtml";
}

<script src="~/Areas/B2B/JsModule/SampleCancellation.js?v1.1"></script>
<style>
    .group td {
        background: #fff9ca !important;
        font-weight: bold;
    }

    .text-white {
        color: #fff !important;
    }

    .total td {
        background: #ffdedd !important;
        font-weight: bold;
    }

    table tbody td {
        padding: 2px;
        font-size: 11px !important;
    }

    #tblSample tbody th {
        border-top: 0;
        background: #513d6f !important;
        color: #fff;
        padding: 0px 5px;
        font-size: 12px;
    }

    table tbody input[type=text], table tbody select {
        width: 100%;
        height: 16px;
        margin: 1px 0;
        border: 1px solid #cbbba4;
        font-size: 13px;
        border-radius: 2px;
    }

    #CampaignDiv {
        display: flex;
        gap: 3px;
        background: #e5f3ff;
        padding: 4px;
        border: 1px solid #dfdfdf;
        border-radius: 2px;
    }

    .tableFixHead {
        overflow-y: auto;
        height: 200px;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
        }

    .btn-info {
        color: #fff !important;
        background-color: #866836;
        border-color: #866836;
    }

    .patient-box {
        border: 1px solid #e7e7e7;
        border-radius: 3px;
        padding: 8px 3px;
        background: #fff;
        margin: 5px 3px;
    }

    .patient-box1 {
        border: 1px solid #e7e7e7;
        border-radius: 3px;
        padding: 8px 3px;
        background: #fff;
        margin: 5px 3px;
    }

    .tblPatient1 th, .tblPatient1 td {
        padding: 1px !important;
        border: none !important;
        font-size: 12px !important;
        background: #ffffff !important;
    }

    .table {
        margin-bottom: 0;
    }

    .tblPatient th, .tblPatient td {
        padding: 1px !important;
        border: none !important;
        font-size: 14px !important;
        background: #ffffff !important;
    }

    .tblPatient button {
        padding: 0 3px;
        float: right;
        margin-right: 5px;
    }

    #patientInfo span.pending {
        background: #d74a45;
        color: #fff;
        padding: 3px 5px;
        border-radius: 5px;
        font-size: 12px;
    }
</style>
<div class="page-box">
    <input type="text" id="hidgetotp" style="display:none" />
    <div class="row">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-body" style="height:800px;background: #f3f3f3;">

                    <div class="example-box-wrapper">
                        <div class="row">
                            <div class="col-xs-12">
                                <div id="CampaignDiv">
                                    <input type="text" id="txtVisitNo" class="form-control" placeholder="Visit No" />
                                    <button onclick="GetServicesRefund()" class="btn btn-warning btn-sm"><i class="fa fa-sign-in">&nbsp;</i>Get</button>
                                </div>
                                <p class="text-danger text-center" style="background: #ffe4e4;font-size:12px;margin-top: 6px;"><b>Note :</b> Cancel=>Full Entry and Same Pay Mode, Refund=>Full and Partial in Cash Only</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-12 form-group">
                                <div class="table-responsive" style="border:1px solid #ccc;margin: 0;height:auto;">
                                    <table class="table table-bordered" id="tblDetails">
                                        <thead>
                                            <tr>
                                                <th class="bg-theme text-white">Gross Amount</th>
                                                <th class="bg-theme text-white">Discount Amount</th>
                                                <th class="bg-theme text-white">Net Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                            <style>
                                .payment {
                                    background: #ffffff;
                                    border-radius: 3px;
                                    border: 1px solid #bdbdbd;
                                    padding: 6px;
                                    margin-top: 5px;
                                    font-size: 12px;
                                }

                                    .payment .item {
                                        width: 100%;
                                    }

                                    .payment .amt {
                                        width: 100%;
                                        display: flex;
                                        align-items: center;
                                        gap: 2%;
                                    }

                                    .payment .IsCheck {
                                        float: right;
                                        margin: -26px 0px;
                                    }

                                #tblPayment {
                                    border-radius: 3px;                                 
                                    overflow:auto;
                                    border: 1px solid #513d6f;
                                    padding-bottom:10px;
                                }
                            </style>
                            <div class="col-xs-12 form-group" id="tblPayment">
                                @*<div class="payment">
                                        <span class="item"><b>Item :</b> COMPLETE BLOOD COUNT (CBC)</span>
                                        <span class="amt"><b>Gross : </b>350, <b>Discount : </b>350, <b>Net : </b>350</span>
                                        <label class="IsCheck"><input type="checkbox" /></label>
                                    </div>*@
                                @*<div class="table-responsive" style="border:1px solid #ccc;margin: 0;height:auto;">
                                        <table class="table table-bordered" id="tblPayment">
                                            <thead>
                                                <tr>
                                                    <th>Gross</th>
                                                    <th>Discount</th>
                                                    <th>Net</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>*@
                            </div>
                        </div>
                        <div class="row" style="background: #fff;">
                            <style>
                                .submit {
                                    margin: 10px 0;
                                    background: #ffffff;
                                    padding: 6px 10px;
                                    gap: 9px;
                                    display: flex;
                                    border: 1px solid #d9d9d9;
                                    align-items: baseline;
                                    border-radius: 3px;
                                }
                            </style>
                            <div class="col-xs-4">
                                <label>Net Amount</label>
                                <input type="text" id="txtnet" disabled="" class="form-control" value="0" />
                            </div>
                            <div class="col-xs-8">
                                <label>Remark</label>
                                <input type="text" id="txtRemark" class="form-control" placeholder="Cancellation Remark" />
                            </div>
                            <div class="col-xs-12">
                                <div class="submit">
                                    <label><input type="radio" onclick="Action()" name="type" value="Cancelled">&nbsp;Cancel</label>
                                    <label><label><input type="radio" onclick="Action()" name="type" value="Refunded">&nbsp;Refund</label></label>
                                    <span style="margin:0 10px;width: 33%;" class="btnAction">
                                        <select id="ddlPayMode" class="form-control border-imp">
                                            <option value="Cash">Cash</option>
                                        </select>
                                    </span>
                                    <input type="button" id="btnRefund" class="btn btn-success btn-sm pull-right" onclick="InsertCancellation()" value="Submit" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

