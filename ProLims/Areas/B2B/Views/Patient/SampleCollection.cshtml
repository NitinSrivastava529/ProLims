
@{
    ViewBag.Title = "SampleCollection";
    Layout = "~/Areas/B2B/Views/Shared/_B2Blayout.cshtml";
}

<script src="~/Areas/B2B/JsModule/SampleCollection.js?v1.3"></script>
<style>
    table tbody td {
        padding: 2px;
        font-size: 11px !important;
    }
    #tblSample tbody th {
        border-top: 0;
        background: #513d6f !important;
        color: #fff;
        padding: 0px 5px;
        font-size: 12px;
    }
    table tbody input[type=text], table tbody select {
        width: 100%;
        height: 16px;
        margin: 1px 0;
        border: 1px solid #cbbba4;
        font-size: 13px;
        border-radius: 2px;
    }

    #CampaignDiv {
        display: flex;
        gap: 3px;
        background: #e5f3ff;
        padding: 4px;
        border: 1px solid #dfdfdf;
        border-radius: 2px;
    }

    .tableFixHead {
        overflow-y: auto;
        height: 200px;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
        }

    .btn-info {
        color: #fff !important;
        background-color: #866836;
        border-color: #866836;
    }

    .patient-box {
        border: 1px solid #e7e7e7;
        border-radius: 3px;
        padding: 8px 3px;
        background: #fff;
        margin: 5px 3px;
    }
    .patient-box1 {
        border: 1px solid #e7e7e7;
        border-radius: 3px;
        padding: 8px 3px;
        background: #fff;
        margin: 5px 3px;
    }
    .tblPatient1 th, .tblPatient1 td {
        padding: 1px !important;
        border: none !important;
        font-size: 12px !important;
        background: #ffffff !important;
    }

    .table {
        margin-bottom: 0;
    }

    .tblPatient th, .tblPatient td {
        padding: 1px !important;
        border: none !important;
        font-size: 14px !important;
        background: #ffffff !important;
    }

    .tblPatient button {
        padding: 0 3px;
        float: right;
        margin-right: 5px;
    }
    #patientInfo span.pending {
        background: #d74a45;
        color: #fff;
        padding: 3px 5px;
        border-radius: 5px;
        font-size: 12px;
    }
</style>
<div class="page-box">
    <input type="text" id="hidgetotp" style="display:none" />
    <div class="row">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-body" style="height:800px;background: #f3f3f3;">
                    <div class="example-box-wrapper">
                        <div class="row">
                            <div class="col-xs-12" id="CampaignDiv">
                                <select class="form-control bn" id="ddlStatus" style="border-color: #0ca526;">
                                    <option>All</option>
                                    <option>Pending</option>
                                    <option>Collected</option>
                                </select>
                                <input type="date" id="txtDate" class="form-control" />
                                <button onclick="PatientInfo()" class="btn btn-warning btn-sm"><i class="fa fa-sign-in">&nbsp;</i>Get</button>
                            </div>
                        </div>
                    </div>
                    <div id="divFormBody">
                        <div class="row" id="patientInfo">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="modelCollect" tabindex="-1">
        <div class="modal-dialog modal-xs">
            <!-- Modal content-->
            <div class="modal-content" style="margin-top:4%;">
                <div class="modal-header" style="background: #513d6f;">
                    Sample Collection
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body" style="padding: 5px;">
                    <div class="row">
                        <div class="col-xs-12 form-group">
                            <div class="patient-box1">
                                <table class="table tblPatient1">
                                    <tr>
                                        <th>UHID</th>
                                        <th>:</th>
                                        <td id="txtVUHID">-</td>
                                        <td>&nbsp;</td>
                                        <th>IPOP No</th>
                                        <th>:</th>
                                        <td id="txtVIPOPNo">-</td>
                                    </tr>
                                    <tr>
                                        <th>Visit No</th>
                                        <th>:</th>
                                        <td id="txtVVisitNo">-</td>
                                        <td>&nbsp;</td>
                                        <th>Age</th>
                                        <th>:</th>
                                        <td id="txtVAge">-</td>
                                    </tr>
                                    <tr>
                                        <th>Name</th>
                                        <th>:</th>
                                        <td id="txtVName">-</td>
                                        <td>&nbsp;</td>
                                        <th>Info</th>
                                        <th>:</th>
                                        <td>
                                            <button class="btn btn-warning btn-sm" style="padding: 0px 10px;"><i class="fa fa-eye">&nbsp;</i>View</button>
                                            <button id="btnScanBarcode" class="btn bg-theme text-white btn-sm" style="padding: 0px 10px;"><i class="fa fa-barcode">&nbsp;</i>Scan</button>
                                        </td>
</table>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-12 form-group">
                                <div class="table-responsive" style="border:1px solid #ccc;margin: 0;height:auto;">
                                    <table class="table table-bordered" id="tblSample">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>Item Name</th>
                                                <th>Samp.Type</th>
                                                <th style="width:25%"><input id="txtbarcodeNo" onkeyup="$('#tblSample tbody input:text').val($(this).val())" style="height: 18px;width: 100%;margin: 3px 0;" type="text" /></th>                                             
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                <button class="btn btn-success btn-sm" onclick="Collect();" style="margin-top:10px;float:right"><i class="fa fa-sign-in">&nbsp;</i>Collect</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="module">
    import "https://cdn.jsdelivr.net/npm/scanbot-web-sdk@7.0.0/bundle/ScanbotSDK.ui2.min.js";
    const sdk = await ScanbotSDK.initialize({
        enginePath:
            "https://cdn.jsdelivr.net/npm/scanbot-web-sdk@7.0.0/bundle/bin/barcode-scanner/",
    });
    document
        .getElementById("btnScanBarcode")
        .addEventListener("click", async () => {
            const config =
                new ScanbotSDK.UI.Config.BarcodeScannerScreenConfiguration();
            const useCase =
                new ScanbotSDK.UI.Config.SingleScanningMode();
            useCase.confirmationSheetEnabled = true;
            config.useCase = useCase;
            const scanResult = await ScanbotSDK.UI.createBarcodeScanner(config);
            if (scanResult ?.items ?.length > 0) {
                $('#txtbarcodeNo').val(scanResult.items[0].barcode.text).trigger('keyup')               
                //document.getElementById("result").innerText =
                //    `Barcode type: ${scanResult.items[0].barcode.format} \n` +
                //    `Barcode content: "${scanResult.items[0].barcode.text}" \n`;
            } else {
                alert("Scanning process canceled");
            }
        });
</script>

