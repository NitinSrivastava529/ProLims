
@{
    ViewBag.Title = "ProDashBoard";
    Layout = "~/Views/Shared/_layout.cshtml";
}
<script src="~/Areas/LISStore/JsModule/Canvas.js"></script>
<script src="~/Areas/LISStore/JsModule/ProDashBoard.js"></script>

<style>
    .card-body {
        padding: 10px;
        color: var(--default-text-color);
    }


    .table td, .table th {
        padding: 5px;
        vertical-align: middle;
        line-height: 14px;
        font-size: 13px;
    }

    .table thead td, .table thead th {
        font-weight: 600;
        font-size: 12px;
        letter-spacing: .5px;
        text-transform: uppercase;
        border-bottom-width: 1px;
        border-top-width: 0;
        padding: 5px;
    }

    hr {
        margin: 0rem 0;
        color: inherit;
        border: 0;
        border-top: var(--bs-border-width) solid;
        opacity: .25;
    }

    .tofixed {
        position: sticky;
        top: 0;
    }

    .select-row {
        background-color: #edffd8;
    }

    .bn {
        border-radius: 0px;
        height: 35px;
        padding: 2px;
        width: 100px;
    }

    .mb-3 {
        margin-bottom: 8px !important;
    }

    .borderbotton {
        border-bottom: 1px solid red !important;
    }

    .select-row {
        background-color: #edffd8;
    }

    label {
        display: inline-block;
        padding: 0px 10px;
    }

    .nav.nav-style-2 .nav-item .nav-link {
        background-color: var(--primary01);
        border-block-start: 3px solid rgb(36 122 243);
        color: var(--primary-color);
    }

        .nav.nav-style-2 .nav-item .nav-link.active {
            border-block-start: 3px solid transparent;
            background: #FF9800;
            color: white;
            border: 1px solid #ccc;
        }

    .tab-content .tab-pane {
        padding: 5px;
        border: 1px solid var(--default-border);
        border-radius: 5px;
        color: var(--default-text-color);
    }

    .totalcount {
        width: 100%;
        border: none;
        background: #FF9800;
        height: 22px;
        border-radius: 4px;
        color: white;
        padding: 5px;
        text-align: center;
    }
</style>
<div class="main-content app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="col-md-10">
                            <div style="display:flex">

                                <label style="width:25%">Pro Name</label>
                                <select id="ddlProName" class="form-control mb-3"></select>
                                <label>From</label>
                                <input id="txtfrom" class="form-control mb-3" type="date" style="width:50%;" />

                                <label>To</label>
                                <input id="txtto" class="form-control mb-3" type="date" style="width:50%;" />

                                <button id="btnget" type="button" class="btn btn-primary mb-3" style="margin-left:10px;width:40%" onclick="GetReport('GetbusinessReport')"><span class="fa fa-search"></span>&nbsp;Search</button>
                            </div>
                        </div>
                        <div class="card-title">
                            Pro DashBoard
                        </div>
                    </div>
                    <hr />
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="table-responsive" style="height:18vh;overflow:auto;border: 1px solid #f3f3f3;">
                                    <table class="table text-nowrap table-bordered table-striped" id="tblReport">
                                        <thead class="tofixed">
                                            <tr>
                                                <th scope="col" style="width:20%">BusinessType</th>
                                                <th scope="col" style='text-align:center;width:20%'>Count</th>
                                                <th scope="col" style="width:15%;text-align:center">Amount</th>
                                                <th scope="col" style="width:15%;text-align:center">Cash Amount</th>
                                                <th scope="col" style="width:15%;text-align:center">Credit Amount</th>
                                                <th scope="col" style="width:15%;text-align:center">share  Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                <div class="footer-a">
                                    <div id="divTotal" style="width:100%;background-color:#bdf1bf;height:24px;"></div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="table-responsive" style="height:18vh;overflow:auto;border: 1px solid #f3f3f3;">
                                    <table class="table table-bordered table-striped" id="tblReportInfo">
                                        <thead class="tofixed">
                                            <tr>
                                                <th scope="col" style=" width: 70%;">Group NAme</th>
                                                <th scope="col" style=" width: 30%;">Count</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                <div class="footer-b">
                                    <div id="divTotalAmount" style="width:100%;background-color:#bdf1bf;height:24px;"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="row" style="text-align: center;margin:0px;background: #e6f4ff;">
                                    <div class="col-md-12">
                                        <label> Salf Trading </label>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <canvas id="myChart" style="width:100%;max-width:600px;height:150px"></canvas>
                                    </div>
                                </div>

                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <ul class="nav nav-pills justify-content-start nav-style-2 mb-3" role="tablist" style="background: #f5f5f5;padding:4px 4px 4px 4px;border-radius:5px;">
                                    <li class="nav-item">
                                        <a class="nav-link active" data-bs-toggle="tab" role="tab" aria-current="page"
                                           href="#home-center" aria-selected="true">
                                            <i class="fas fa-users"></i>&nbsp;Pro Wise
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-bs-toggle="tab" role="tab" aria-current="page"
                                           href="#about-center" aria-selected="true"><i class="fa fa-bank"></i>&nbsp;Panel Wise</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="tab-content">
                                    <div class="tab-pane show active text-muted" id="home-center" role="tabpanel">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="table-responsive tblscoll" style="height:40vh;border:1px solid #ccc;overflow:auto">


                                                    <table class="table table-bordered" id="tblProReport" style="width:100%;">
                                                        <thead style="background: #2d82ff;color: white;" class="tofixed">
                                                            <tr>
                                                                <th>ProName</th>
                                                                <th style="text-align:center;width:10%">Count</th>
                                                                <th style="text-align:center;width:10%">Amount</th>
                                                                <th style="text-align:center;width:10%">CashAmount</th>
                                                                <th style="text-align:center;width:10%">CreditAmount</th>
                                                                <th style="text-align:center;width:10%">ShareAmount</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody></tbody>
                                                    </table>

                                                </div>
                                                <div class="footer-a">
                                                    <div id="divTotalPro" style="width:100%;background-color:#bdf1bf;height:24px;"></div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="tab-pane text-muted" id="about-center" role="tabpanel">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="table-responsive tblscoll" style="height:35vh;border:1px solid #ccc;overflow:auto">
                                                        <table class="table table-bordered" id="tblPanelReport" style="width:100%;">
                                                            <thead style="background: #2d82ff;color: white;" class="tofixed">
                                                                <tr>

                                                                    <th>ProName</th>
                                                                    <th>DoctorName </th>
                                                                    <th> Group Name </th>

                                                                    <th>ItemName</th>
                                                                    <th style="text-align:center">TestCount</th>
                                                                    <th style="text-align:center">Amount</th>
                                                                    <th style="text-align:center">CashAmount</th>
                                                                    <th style="text-align:center">CreditAmount</th>
                                                                    <th style="text-align:center">ShareAmount</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody></tbody>
                                                        </table>
                                                    </div>
                         
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div id="divTotal" style="width:100%"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
